---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CodeTabs from "@/components/CodeTabs.astro";
import DefineOnce from "@/components/DefineOnce.astro";
import DesignSwitcher from "@/components/DesignSwitcher.astro";
import Glyph from "@/components/Glyph.astro";
import MicronautBand from "@/components/MicronautBand.astro";
import SkepticTest from "@/components/SkepticTest.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import {
  CODE_PROOFS,
  DEEP_DIVES,
  FEATURES,
  FOOTER_COLUMNS,
  HERO,
  PERSONAS,
  SITE_NAME,
  STACK_COMPARISON,
  WORKFLOW,
} from "@/lib/site-content";

const navLinks = [
  { label: "Why Pyronaut", href: "#features" },
  { label: "Code", href: "#code" },
  { label: "Workflow", href: "#workflow" },
  { label: "Teams", href: "#teams" },
];
---

<BaseLayout
  title={`${SITE_NAME} — Integrated application platform for Python`}
  bodyClass="bg-white font-sans text-ink-800 antialiased dark:bg-ink-950 dark:text-ink-100"
>
  <!-- Header -->
  <header
    class="sticky top-0 z-40 border-b border-ink-100 bg-white/85 backdrop-blur-lg dark:border-white/10 dark:bg-ink-950/85"
  >
    <div class="mx-auto flex h-16 max-w-7xl items-center gap-8 px-5">
      <a href="/designs/mission-control/" class="flex shrink-0 items-center">
        <img
          src="/pyronaut-assets/logo-header.png"
          alt="Pyronaut"
          class="h-9 w-auto dark:hidden"
        />
        <img
          src="/pyronaut-assets/logo-header-dark.png"
          alt="Pyronaut"
          class="hidden h-9 w-auto dark:block"
        />
      </a>
      <nav class="hidden gap-1 md:flex">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="rounded-lg px-3 py-2 text-sm font-medium text-ink-500 transition hover:bg-flame-50 hover:text-ink-800 dark:text-ink-300 dark:hover:bg-white/5 dark:hover:text-white"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      <div class="ml-auto flex items-center gap-2">
        <ThemeToggle class="rounded-lg p-2 text-ink-500 transition hover:bg-ink-50 dark:text-ink-300 dark:hover:bg-white/10" />
        <a
          href="https://github.com/micronaut-projects"
          class="hidden items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium text-ink-500 transition hover:bg-ink-50 hover:text-ink-800 dark:text-ink-300 dark:hover:bg-white/5 dark:hover:text-white sm:flex"
        >
          <Glyph name="github" class="size-4.5" />
          GitHub
        </a>
        <a
          href="#get-started"
          class="rounded-lg bg-gradient-to-r from-flame-500 to-ember-500 px-4 py-2 text-sm font-semibold text-white shadow-sm shadow-flame-500/30 transition hover:brightness-110"
        >
          Get started
        </a>
      </div>
    </div>
  </header>

  <main>
    <!-- Hero -->
    <section
      class="relative overflow-hidden border-b border-ink-100 dark:border-white/10"
    >
      <div
        class="pointer-events-none absolute inset-0 dark:hidden"
        style="background-image: radial-gradient(circle at 1px 1px, var(--color-ink-100) 1px, transparent 0); background-size: 26px 26px;"
      >
      </div>
      <div
        class="pointer-events-none absolute -right-40 -top-40 size-[560px] rounded-full bg-gradient-to-br from-flame-300/40 via-flame-200/25 to-transparent blur-3xl dark:from-flame-500/25 dark:via-ember-500/10"
      >
      </div>
      <div
        class="relative mx-auto grid max-w-7xl gap-14 px-5 py-20 lg:grid-cols-[minmax(0,1fr)_440px] lg:items-center lg:py-24"
      >
        <div>
          <p
            class="inline-flex items-center gap-2 rounded-full border border-flame-200 bg-flame-50 px-3.5 py-1.5 text-xs font-semibold text-flame-700 dark:border-flame-500/40 dark:bg-flame-500/10 dark:text-flame-300"
          >
            <Glyph name="flame" class="size-3.5" />
            {HERO.eyebrow}
          </p>
          <h1
            class="mt-6 max-w-2xl font-display text-5xl font-bold leading-[1.05] tracking-tight text-ink-900 dark:text-white md:text-6xl"
          >
            Build the Python application.{" "}
            <span class="text-flame-gradient">Not the platform around it.</span>
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-8 text-ink-500 dark:text-ink-300">
            {HERO.copy}
          </p>
          <div class="mt-6 flex flex-wrap gap-2">
            {
              HERO.badges.map((badge) => (
                <span class="rounded-full border border-ink-200 bg-white px-3 py-1.5 text-xs font-medium text-ink-500 dark:border-white/15 dark:bg-white/5 dark:text-ink-200">
                  {badge}
                </span>
              ))
            }
          </div>
          <div class="mt-8 flex flex-wrap gap-3" id="get-started">
            <a
              href="#code"
              class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-flame-500 to-ember-500 px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-flame-500/25 transition hover:brightness-110"
            >
              Get started
              <Glyph name="arrow-right" class="size-4" />
            </a>
            <a
              href="#workflow"
              class="inline-flex items-center gap-2 rounded-xl border border-ink-200 bg-white px-6 py-3.5 text-sm font-semibold text-ink-700 transition hover:border-flame-300 hover:bg-flame-50 dark:border-white/15 dark:bg-white/5 dark:text-white dark:hover:border-flame-500/50 dark:hover:bg-flame-500/10"
            >
              See the workflow
            </a>
          </div>
        </div>

        <!-- Hero terminal card (dark in both modes, like a real terminal) -->
        <div class="relative">
          <div
            class="absolute -inset-4 rounded-3xl bg-gradient-to-br from-flame-400/20 to-ember-500/10 blur-2xl"
          >
          </div>
          <div
            class="relative overflow-hidden rounded-2xl border border-ink-200 bg-ink-900 shadow-2xl shadow-ink-900/20 dark:border-white/10"
          >
            <div
              class="flex items-center gap-2 border-b border-white/10 px-4 py-3"
            >
              <span class="size-2.5 rounded-full bg-ember-500/80"></span>
              <span class="size-2.5 rounded-full bg-python-yellow/80"></span>
              <span class="size-2.5 rounded-full bg-flame-400/80"></span>
              <span class="ml-2 font-mono text-xs text-ink-400">
                rocket-service — pyronaut
              </span>
            </div>
            <div class="p-5 font-mono text-[0.8rem] leading-7">
              <p class="text-ink-300">
                <span class="text-flame-400">$</span> pyronaut dev
              </p>
              <p class="text-ink-400">
                <span class="text-python-yellow">◆</span> Test Resources:
                postgres:17 ready
              </p>
              <p class="text-ink-400">
                <span class="text-python-yellow">◆</span> DI graph validated ·
                42 beans
              </p>
              <p class="text-emerald-400">
                ➜ Server running on http://localhost:8080
              </p>
              <p class="mt-3 text-ink-300">
                <span class="text-flame-400">$</span> pyronaut build --native
              </p>
              <p class="text-emerald-400">
                ✔ Native executable ready · build/rocket-service
              </p>
              <p class="mt-3 flex items-center gap-2 text-ink-500">
                <img
                  src="/pyronaut-assets/favicon.png"
                  alt=""
                  class="size-5 rounded"
                />
                Python on GraalPy · Micronaut inside
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section
      id="features"
      class="border-b border-ink-100 bg-ink-50 dark:border-white/10 dark:bg-ink-900/50"
    >
      <div class="mx-auto max-w-7xl px-5 py-20">
        <div
          class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between"
        >
          <h2
            class="max-w-md font-display text-3xl font-bold tracking-tight text-ink-900 dark:text-white md:text-4xl"
          >
            One platform, designed to work together
          </h2>
          <p class="max-w-lg text-base leading-7 text-ink-500 dark:text-ink-300">
            Configuration, testing, validation, infrastructure, and
            packaging - handled one consistent way.
          </p>
        </div>
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {
            FEATURES.map((feature) => (
              <a
                href={feature.href}
                class="group rounded-2xl border border-ink-100 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-flame-300 hover:shadow-lg hover:shadow-flame-500/10 dark:border-white/10 dark:bg-white/[0.03] dark:hover:border-flame-500/50 dark:hover:bg-flame-500/[0.06]"
              >
                <span class="inline-grid size-11 place-items-center rounded-xl bg-gradient-to-br from-flame-50 to-flame-100 text-flame-600 transition group-hover:from-flame-500 group-hover:to-ember-500 group-hover:text-white dark:from-flame-500/15 dark:to-ember-500/15 dark:text-flame-400">
                  <Glyph name={feature.icon} class="size-5.5" />
                </span>
                <h3 class="mt-4 font-display text-base font-semibold text-ink-900 dark:text-white">
                  {feature.title}
                </h3>
                <p class="mt-2 text-sm leading-6 text-ink-500 dark:text-ink-300">
                  {feature.copy}
                </p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Code showcase -->
    <section
      id="code"
      class="border-b border-ink-100 bg-white dark:border-white/10 dark:bg-ink-950"
    >
      <div
        class="mx-auto grid max-w-7xl gap-12 px-5 py-20 lg:grid-cols-[360px_minmax(0,1fr)]"
      >
        <div>
          <p class="text-sm font-semibold uppercase tracking-wider text-flame-700 dark:text-flame-400">
            The programming model
          </p>
          <h2
            class="mt-3 font-display text-3xl font-bold tracking-tight text-ink-900 dark:text-white md:text-4xl"
          >
            Python that uses Micronaut directly
          </h2>
          <p class="mt-4 text-base leading-7 text-ink-500 dark:text-ink-300">
            Write controllers and inject services with familiar Python constructs
            like dataclasses and type hints, then test the running application with
            pytest.
          </p>
          <ul class="mt-7 grid gap-3">
            {
              CODE_PROOFS.map((proof) => (
                <li class="flex items-start gap-2.5 text-sm leading-6 text-ink-600 dark:text-ink-200">
                  <Glyph
                    name="check-circle"
                    class="mt-0.5 size-5 shrink-0 text-flame-500 dark:text-flame-400"
                  />
                  {proof}
                </li>
              ))
            }
          </ul>
          <div class="mt-7">
            <DefineOnce />
          </div>
        </div>
        <CodeTabs variant="mission-control" id="mc-code" />
      </div>
    </section>

    <!-- Workflow -->
    <section
      id="workflow"
      class="border-b border-ink-100 bg-ink-50 dark:border-white/10 dark:bg-ink-900/50"
    >
      <div class="mx-auto max-w-7xl px-5 py-20">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-sm font-semibold uppercase tracking-wider text-flame-700 dark:text-flame-400">
            One application workflow
          </p>
          <h2
            class="mt-3 font-display text-3xl font-bold tracking-tight text-ink-900 dark:text-white md:text-4xl"
          >
            From <code class="font-mono text-flame-700 dark:text-flame-400">create</code> to
            production artifact
          </h2>
          <p class="mt-4 text-base leading-7 text-ink-500 dark:text-ink-300">
            The same platform coordinates how the application is created,
            developed, tested, validated, and packaged.
          </p>
        </div>
        <ol class="mt-12 grid gap-4 md:grid-cols-5">
          {
            WORKFLOW.map((stage, index) => (
              <li class="relative">
                {index < WORKFLOW.length - 1 && (
                  <span class="absolute -right-4 top-8 hidden text-flame-400 md:block">
                    <Glyph name="arrow-right" class="size-4" />
                  </span>
                )}
                <div class="h-full rounded-2xl border border-ink-100 bg-white p-5 shadow-sm dark:border-white/10 dark:bg-white/[0.03]">
                  <span class="inline-grid size-8 place-items-center rounded-full bg-gradient-to-br from-flame-500 to-ember-500 text-sm font-bold text-white">
                    {index + 1}
                  </span>
                  <h3 class="mt-3 font-display text-base font-semibold text-ink-900 dark:text-white">
                    {stage.title}
                  </h3>
                  <code class="mt-1 block font-mono text-xs text-flame-700 dark:text-flame-400">
                    {stage.command}
                  </code>
                  <p class="mt-2 text-sm leading-6 text-ink-500 dark:text-ink-300">
                    {stage.copy}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Deep dives -->
    <section class="border-b border-ink-100 bg-white dark:border-white/10 dark:bg-ink-950">
      <div class="mx-auto grid max-w-7xl gap-6 px-5 py-20 lg:grid-cols-3">
        {
          DEEP_DIVES.map((dive) => (
            <article class="flex flex-col rounded-2xl border border-ink-100 bg-white p-7 shadow-sm dark:border-white/10 dark:bg-white/[0.03]">
              <span class="inline-grid size-12 place-items-center rounded-xl bg-gradient-to-br from-flame-500 to-ember-500 text-white shadow-md shadow-flame-500/25">
                <Glyph name={dive.icon} class="size-6" />
              </span>
              <h3 class="mt-5 font-display text-xl font-semibold text-ink-900 dark:text-white">
                {dive.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-ink-500 dark:text-ink-300">
                {dive.copy}
              </p>
              <ul class="mt-5 grid gap-2.5">
                {dive.bullets.map((bullet) => (
                  <li class="flex items-center gap-2.5 text-sm text-ink-600 dark:text-ink-200">
                    <Glyph
                      name="check"
                      class="size-4 shrink-0 text-flame-500 dark:text-flame-400"
                    />
                    {bullet}
                  </li>
                ))}
              </ul>
              <a
                href={dive.href}
                class="mt-auto inline-flex items-center gap-1.5 pt-6 text-sm font-semibold text-flame-600 transition hover:gap-2.5 dark:text-flame-400"
              >
                {dive.linkLabel}
                <Glyph name="arrow-right" class="size-4" />
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Stack comparison (dark band in both modes) -->
    <section class="border-b border-ink-100 bg-ink-900 text-white dark:border-white/10 dark:bg-ink-900/70">
      <div class="mx-auto max-w-7xl px-5 py-20">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="font-display text-3xl font-bold tracking-tight md:text-4xl">
            Stop assembling your Python backend
          </h2>
          <p class="mt-4 text-base leading-7 text-ink-300">
            Python&rsquo;s flexibility is a strength, and every component in a
            hand-assembled stack may be excellent. The cost is the repeated
            integration work between them, and someone has to own it.
          </p>
        </div>
        <div class="mx-auto mt-12 grid max-w-4xl gap-6 md:grid-cols-2">
          <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-7">
            <h3 class="font-display text-lg font-semibold text-ink-300">
              {STACK_COMPARISON.conventional.title}
            </h3>
            <ul class="mt-5 grid gap-3">
              {
                STACK_COMPARISON.conventional.items.map((item) => (
                  <li class="flex items-center gap-3 text-sm text-ink-300">
                    <span class="size-1.5 shrink-0 rounded-full bg-ink-400" />
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>
          <div
            class="rounded-2xl border border-flame-500/40 bg-gradient-to-b from-flame-500/15 to-transparent p-7 shadow-lg shadow-flame-500/10"
          >
            <h3
              class="flex items-center gap-2 font-display text-lg font-semibold text-flame-300"
            >
              <Glyph name="flame" class="size-5" />
              {STACK_COMPARISON.pyronaut.title}
            </h3>
            <ul class="mt-5 grid gap-3">
              {
                STACK_COMPARISON.pyronaut.items.map((item) => (
                  <li class="flex items-center gap-3 text-sm text-white">
                    <Glyph name="check" class="size-4 shrink-0 text-flame-400" />
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
        <SkepticTest tone="dark" />
      </div>
    </section>

    <!-- Personas -->
    <section id="teams" class="border-b border-ink-100 bg-white dark:border-white/10 dark:bg-ink-950">
      <div class="mx-auto max-w-7xl px-5 py-20">
        <h2
          class="text-center font-display text-3xl font-bold tracking-tight text-ink-900 dark:text-white md:text-4xl"
        >
          Built for teams that ship many services
        </h2>
        <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          {
            PERSONAS.map((persona) => (
              <div class="rounded-2xl border border-ink-100 bg-ink-50 p-6 dark:border-white/10 dark:bg-white/[0.03]">
                <p class="font-display text-sm font-bold uppercase tracking-wide text-flame-700 dark:text-flame-400">
                  {persona.role}
                </p>
                <p class="mt-3 text-sm leading-7 text-ink-600 dark:text-ink-200">
                  {persona.value}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA band -->
    <section class="relative overflow-hidden bg-gradient-to-r from-flame-600 via-flame-500 to-ember-500">
      <div
        class="mx-auto flex max-w-7xl flex-col items-center gap-8 px-5 py-16 md:flex-row md:justify-between"
      >
        <div class="flex items-center gap-6">
          <img
            src="/pyronaut-assets/logo-full.png"
            alt="Pyronaut logo"
            class="hidden w-44 drop-shadow-xl sm:block"
          />
          <div>
            <h2 class="font-display text-3xl font-bold text-white">
              Light the engines
            </h2>
            <p class="mt-2 max-w-md text-sm leading-6 text-white/85">
              Create your first Pyronaut service and go from Python source to a
              tested, validated production artifact.
            </p>
          </div>
        </div>
        <div class="flex flex-wrap gap-3">
          <a
            href="/docs/"
            class="rounded-xl bg-white px-6 py-3.5 text-sm font-semibold text-flame-600 shadow-lg transition hover:bg-flame-50"
          >
            Read the docs
          </a>
          <a
            href="https://github.com/micronaut-projects"
            class="rounded-xl border border-white/40 px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-white/10"
          >
            Star on GitHub
          </a>
        </div>
      </div>
    </section>

    <MicronautBand />
  </main>

  <!-- Footer -->
  <footer class="bg-ink-950 text-ink-300 dark:border-t dark:border-white/10">
    <div class="mx-auto max-w-7xl px-5 py-14">
      <div class="grid gap-10 md:grid-cols-[minmax(0,1.2fr)_repeat(3,minmax(0,1fr))]">
        <div>
          <img
            src="/pyronaut-assets/logo-header-dark.png"
            alt="Pyronaut"
            class="h-9 w-auto"
          />
          <p class="mt-4 max-w-xs text-sm leading-6 text-ink-400">
            An integrated application platform for Python, built on
            Micronaut.
          </p>
        </div>
        {
          FOOTER_COLUMNS.map((column) => (
            <div>
              <h3 class="text-sm font-semibold text-white">{column.title}</h3>
              <ul class="mt-4 grid gap-2.5">
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="text-sm text-ink-400 transition hover:text-flame-400"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <p class="mt-12 border-t border-white/10 pt-6 text-xs text-ink-500">
        © 2026 The Pyronaut Project. Python on GraalPy, powered by the
        Micronaut framework and GraalVM.
      </p>
    </div>
  </footer>

  <DesignSwitcher current="mission-control" />
</BaseLayout>
