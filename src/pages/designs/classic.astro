---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BestFitSignals from "@/components/BestFitSignals.astro";
import CodeTabs from "@/components/CodeTabs.astro";
import DefineOnce from "@/components/DefineOnce.astro";
import DesignSwitcher from "@/components/DesignSwitcher.astro";
import Glyph from "@/components/Glyph.astro";
import MicronautBand from "@/components/MicronautBand.astro";
import SkepticTest from "@/components/SkepticTest.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import {
  CODE_PROOFS,
  DEEP_DIVES,
  FEATURES,
  FOOTER_COLUMNS,
  HERO,
  PERSONAS,
  SITE_NAME,
  STACK_COMPARISON,
  WORKFLOW,
} from "@/lib/site-content";

/**
 * "Classic" — deliberately close to micronaut.io's design language:
 * bordered sections alternating background/muted, compact cards, outline
 * badges, a numbered-steps hero card, and ghost arrow links.
 */

const navLinks = [
  { label: "Why Pyronaut", href: "#features" },
  { label: "Code", href: "#code" },
  { label: "Workflow", href: "#workflow" },
  { label: "Teams", href: "#teams" },
];

const heroSteps = [
  {
    title: "Process source",
    copy: "Resolve DI, serialization, and validation metadata from Python source before the app runs.",
  },
  {
    title: "Generate metadata",
    copy: "OpenAPI, configuration schemas, and IDE stubs come out of processing, not runtime discovery.",
  },
  {
    title: "Start with less runtime work",
    copy: "Lean startup paths for services, containers, and GraalVM native images.",
  },
];

const testResourceServices = [
  "PostgreSQL",
  "MySQL",
  "Oracle DB",
  "Redis",
  "Kafka",
  "Testcontainers",
];

const packagingSteps = ["Python source", "Processed + validated", "Production artifact"];
---

<BaseLayout
  title={`${SITE_NAME} — Integrated application platform for Python`}
  bodyClass="bg-white font-sans text-ink-800 antialiased dark:bg-ink-950 dark:text-ink-100"
>
  <!-- Header -->
  <header
    class="sticky top-0 z-40 border-b border-ink-200 bg-white/90 backdrop-blur dark:border-ink-700 dark:bg-ink-950/90"
  >
    <div class="mx-auto flex h-[3.75rem] max-w-6xl items-center gap-6 px-5">
      <a href="/designs/classic/" class="flex shrink-0 items-center">
        <img
          src="/pyronaut-assets/logo-header.png"
          alt="Pyronaut"
          class="h-8 w-auto dark:hidden"
        />
        <img
          src="/pyronaut-assets/logo-header-dark.png"
          alt="Pyronaut"
          class="hidden h-8 w-auto dark:block"
        />
      </a>
      <nav class="hidden gap-0.5 md:flex">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="rounded-md px-3 py-2 text-sm font-medium text-ink-600 transition hover:bg-ink-50 hover:text-ink-900 dark:text-ink-300 dark:hover:bg-ink-800 dark:hover:text-white"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      <div class="ml-auto flex items-center gap-1.5">
        <ThemeToggle class="rounded-md p-2 text-ink-600 transition hover:bg-ink-50 dark:text-ink-300 dark:hover:bg-ink-800" />
        <a
          href="https://github.com/micronaut-projects"
          class="hidden items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-ink-600 transition hover:bg-ink-50 hover:text-ink-900 dark:text-ink-300 dark:hover:bg-ink-800 dark:hover:text-white sm:flex"
        >
          <Glyph name="github" class="size-4.5" />
          GitHub
        </a>
        <a
          href="#get-started"
          class="rounded-md bg-flame-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-flame-500"
        >
          Get started
        </a>
      </div>
    </div>
  </header>

  <main>
    <!-- Hero -->
    <section class="border-b border-ink-200 bg-white dark:border-ink-700 dark:bg-ink-950">
      <div
        class="mx-auto grid max-w-6xl gap-12 px-5 py-16 lg:grid-cols-[minmax(0,1fr)_420px] lg:items-center lg:py-20"
      >
        <div class="max-w-[680px]">
          <h1
            class="text-[3.1rem] font-extrabold leading-[1.02] tracking-tight text-ink-900 dark:text-white md:text-[3.9rem]"
          >
            An integrated application platform for{" "}
            <span class="text-flame-700 dark:text-flame-400">Python</span>
          </h1>
          <p
            class="mt-5 max-w-[620px] text-[1.05rem] leading-8 text-ink-500 dark:text-ink-300"
          >
            {HERO.copy}
          </p>
          <div class="mt-6 flex flex-wrap gap-2.5">
            {
              HERO.badges.map((badge) => (
                <span class="rounded-md border border-ink-200 bg-white px-3 py-1.5 text-xs font-medium text-ink-600 dark:border-ink-700 dark:bg-ink-900 dark:text-ink-300">
                  {badge}
                </span>
              ))
            }
          </div>
          <div class="mt-7 flex flex-wrap gap-3" id="get-started">
            <a
              href="#code"
              class="rounded-md bg-flame-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-flame-500"
            >
              View documentation
            </a>
            <a
              href="#workflow"
              class="rounded-md border border-ink-200 bg-white px-5 py-2.5 text-sm font-semibold text-ink-700 transition hover:border-flame-500/50 hover:bg-flame-50 dark:border-ink-700 dark:bg-ink-900 dark:text-ink-100 dark:hover:bg-ink-800"
            >
              Launch a project
            </a>
            <a
              href="#features"
              class="rounded-md border border-ink-200 bg-white px-5 py-2.5 text-sm font-semibold text-ink-700 transition hover:border-flame-500/50 hover:bg-flame-50 dark:border-ink-700 dark:bg-ink-900 dark:text-ink-100 dark:hover:bg-ink-800"
            >
              Browse guides
            </a>
          </div>
        </div>

        <!-- Numbered-steps card, micronaut style -->
        <div
          class="overflow-hidden rounded-xl border border-flame-200 bg-white shadow-lg shadow-flame-500/5 dark:border-flame-500/25 dark:bg-ink-900"
        >
          <div class="grid grid-cols-[48px_minmax(0,1fr)] gap-4 p-6 pb-2">
            <div
              class="grid size-11 place-items-center rounded-lg bg-flame-50 dark:bg-flame-500/10"
            >
              <img
                src="/pyronaut-assets/mascot-wide.png"
                alt=""
                aria-hidden="true"
                class="size-9 object-contain"
              />
            </div>
            <div>
              <p class="text-[1.05rem] font-semibold leading-6 text-ink-900 dark:text-white">
                Prepare the application before it starts
              </p>
              <p class="mt-1 text-sm text-ink-500 dark:text-ink-300">
                Build-time platform work keeps runtime behavior lean.
              </p>
            </div>
          </div>
          <div class="p-6 pt-4">
            <div
              class="relative grid gap-4 rounded-lg bg-ink-50 p-5 before:absolute before:bottom-8 before:left-[33px] before:top-8 before:w-px before:bg-flame-600/25 dark:bg-ink-800/70"
            >
              {
                heroSteps.map((step, index) => (
                  <div class="relative grid grid-cols-[30px_minmax(0,1fr)] gap-3">
                    <span class="flex size-7 items-center justify-center rounded-full bg-flame-600 text-xs font-semibold text-white">
                      {index + 1}
                    </span>
                    <div>
                      <p class="text-sm font-semibold text-ink-900 dark:text-white">
                        {step.title}
                      </p>
                      <p class="mt-1 text-sm leading-6 text-ink-500 dark:text-ink-300">
                        {step.copy}
                      </p>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section
      id="features"
      class="border-b border-ink-200 bg-ink-50/70 dark:border-ink-700 dark:bg-ink-900/50"
    >
      <div class="mx-auto grid max-w-6xl gap-7 px-5 py-16">
        <div
          class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between"
        >
          <h2
            class="max-w-[480px] text-3xl font-bold tracking-tight text-ink-900 dark:text-white md:text-4xl"
          >
            Built around Pyronaut's strongest differentiators
          </h2>
          <p class="max-w-[560px] text-base leading-7 text-ink-500 dark:text-ink-300">
            The Micronaut programming model, build-time processing, integrated
            testing, production validation, and native packaging work together
            instead of competing for attention.
          </p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {
            FEATURES.map((feature) => (
              <a
                href={feature.href}
                class="group rounded-xl border border-ink-200 bg-white p-5 transition hover:-translate-y-0.5 hover:border-flame-500/50 hover:shadow-md dark:border-ink-700 dark:bg-ink-900 dark:hover:border-flame-500/50"
              >
                <span class="mb-3 grid size-11 place-items-center rounded-lg bg-flame-50 text-flame-600 dark:bg-flame-500/10 dark:text-flame-400">
                  <Glyph name={feature.icon} class="size-6" />
                </span>
                <h3 class="text-[1rem] font-semibold leading-6 text-ink-900 dark:text-white">
                  {feature.title}
                </h3>
                <p class="mt-1.5 text-[0.92rem] leading-6 text-ink-500 dark:text-ink-300">
                  {feature.copy}
                </p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Code showcase -->
    <section
      id="code"
      class="border-b border-ink-200 bg-white dark:border-ink-700 dark:bg-ink-950"
    >
      <div
        class="mx-auto grid max-w-6xl gap-10 px-5 py-16 lg:grid-cols-[340px_minmax(0,1fr)]"
      >
        <div>
          <h2
            class="mt-4 text-3xl font-bold tracking-tight text-ink-900 dark:text-white md:text-4xl"
          >
            Build an endpoint and a test with one model
          </h2>
          <p class="mt-4 text-base leading-7 text-ink-500 dark:text-ink-300">
            Define a controller with Micronaut annotations on plain Python, then
            test it against the same application context — all coordinated by
            one CLI.
          </p>
          <div class="mt-6 grid gap-3 text-sm leading-6 text-ink-500 dark:text-ink-300">
            {
              CODE_PROOFS.map((proof) => (
                <div class="flex items-start gap-2">
                  <Glyph
                    name="check-circle"
                    class="mt-1 size-4 shrink-0 text-flame-700 dark:text-flame-400"
                  />
                  <span>{proof}</span>
                </div>
              ))
            }
          </div>
          <div class="mt-6">
            <DefineOnce />
          </div>
        </div>
        <CodeTabs variant="classic" id="cl-code" />
      </div>
    </section>

    <!-- Workflow -->
    <section
      id="workflow"
      class="border-b border-ink-200 bg-ink-50/70 dark:border-ink-700 dark:bg-ink-900/50"
    >
      <div class="mx-auto grid max-w-6xl gap-7 px-5 py-16">
        <div class="max-w-2xl">
          <h2 class="text-3xl font-bold tracking-tight text-ink-900 dark:text-white md:text-4xl">
            One application workflow
          </h2>
          <p class="mt-4 text-base leading-7 text-ink-500 dark:text-ink-300">
            The same platform coordinates how the application is created,
            developed, tested, validated, and packaged.
          </p>
        </div>
        <ol class="grid gap-3 md:grid-cols-5">
          {
            WORKFLOW.map((stage, index) => (
              <li class="relative rounded-xl border border-ink-200 bg-white p-4 dark:border-ink-700 dark:bg-ink-900">
                <div class="flex items-center gap-2">
                  <span class="flex size-6 items-center justify-center rounded-full bg-flame-600 text-[0.7rem] font-semibold text-white">
                    {index + 1}
                  </span>
                  <h3 class="text-sm font-semibold text-ink-900 dark:text-white">
                    {stage.title}
                  </h3>
                </div>
                <code class="mt-2 block font-mono text-xs text-flame-700 dark:text-flame-400">
                  {stage.command}
                </code>
                <p class="mt-1.5 text-[0.85rem] leading-5 text-ink-500 dark:text-ink-300">
                  {stage.copy}
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Three deep cards, micronaut's 3-card section style -->
    <section class="border-b border-ink-200 bg-white dark:border-ink-700 dark:bg-ink-950">
      <div
        class="mx-auto grid max-w-6xl gap-6 px-5 py-16 lg:grid-cols-3"
      >
        <!-- Card 1: prepare before start -->
        <div
          class="flex h-full min-w-0 flex-col rounded-xl border border-flame-200 bg-white p-6 shadow-md shadow-black/[0.03] dark:border-flame-500/25 dark:bg-ink-900"
        >
          <span class="mb-3 grid size-11 place-items-center rounded-lg bg-flame-50 text-flame-600 dark:bg-flame-500/10 dark:text-flame-400">
            <Glyph name={DEEP_DIVES[0]!.icon} class="size-6" />
          </span>
          <h3 class="text-lg font-semibold text-ink-900 dark:text-white">
            {DEEP_DIVES[0]!.title}
          </h3>
          <p class="mt-2 text-sm leading-6 text-ink-500 dark:text-ink-300">
            {DEEP_DIVES[0]!.copy}
          </p>
          <div class="mt-4 grid gap-2 text-sm leading-6 text-ink-500 dark:text-ink-300">
            {
              DEEP_DIVES[0]!.bullets.map((bullet) => (
                <div class="flex items-center gap-2">
                  <Glyph name="check-circle" class="size-4 text-flame-700 dark:text-flame-400" />
                  <span>{bullet}</span>
                </div>
              ))
            }
          </div>
          <a
            href={DEEP_DIVES[0]!.href}
            class="mt-auto inline-flex items-center gap-1.5 pt-5 text-sm font-semibold text-flame-600 hover:underline dark:text-flame-400"
          >
            {DEEP_DIVES[0]!.linkLabel}
            <Glyph name="arrow-right" class="size-4" />
          </a>
        </div>

        <!-- Card 2: packaging pipeline diagram -->
        <div
          class="flex h-full min-w-0 flex-col rounded-xl border border-ink-200 bg-white p-6 shadow-md shadow-black/[0.03] dark:border-ink-700 dark:bg-ink-900"
        >
          <span class="mb-3 grid size-11 place-items-center rounded-lg bg-flame-50 text-flame-600 dark:bg-flame-500/10 dark:text-flame-400">
            <Glyph name={DEEP_DIVES[2]!.icon} class="size-6" />
          </span>
          <h3 class="text-lg font-semibold text-ink-900 dark:text-white">
            {DEEP_DIVES[2]!.title}
          </h3>
          <p class="mt-2 text-sm leading-6 text-ink-500 dark:text-ink-300">
            {DEEP_DIVES[2]!.copy}
          </p>
          <div class="mt-4 grid gap-2 rounded-lg bg-ink-50 p-4 text-sm dark:bg-ink-800/70">
            {
              packagingSteps.map((step, index) => (
                <>
                  <div
                    class:list={[
                      "rounded-md border p-2.5 text-center font-medium leading-5",
                      index === packagingSteps.length - 1
                        ? "border-flame-600 bg-flame-600 text-white"
                        : "border-ink-200 bg-white text-ink-800 dark:border-ink-600 dark:bg-ink-900 dark:text-ink-100",
                    ]}
                  >
                    {step}
                  </div>
                  {index < packagingSteps.length - 1 && (
                    <div class="flex justify-center text-flame-700 dark:text-flame-400">
                      <Glyph name="arrow-right" class="size-5 rotate-90" />
                    </div>
                  )}
                </>
              ))
            }
          </div>
          <div class="mt-4 grid gap-2 text-sm leading-6 text-ink-500 dark:text-ink-300">
            {
              DEEP_DIVES[2]!.bullets.map((bullet) => (
                <div class="flex items-center gap-2">
                  <Glyph name="check-circle" class="size-4 text-flame-700 dark:text-flame-400" />
                  <span>{bullet}</span>
                </div>
              ))
            }
          </div>
          <a
            href={DEEP_DIVES[2]!.href}
            class="mt-auto inline-flex items-center gap-1.5 pt-5 text-sm font-semibold text-flame-600 hover:underline dark:text-flame-400"
          >
            {DEEP_DIVES[2]!.linkLabel}
            <Glyph name="arrow-right" class="size-4" />
          </a>
        </div>

        <!-- Card 3: test resources services grid -->
        <div
          class="flex h-full min-w-0 flex-col rounded-xl border border-ink-200 bg-white p-6 shadow-md shadow-black/[0.03] dark:border-ink-700 dark:bg-ink-900"
        >
          <span class="mb-3 grid size-11 place-items-center rounded-lg bg-flame-50 text-flame-600 dark:bg-flame-500/10 dark:text-flame-400">
            <Glyph name="database" class="size-6" />
          </span>
          <h3 class="text-lg font-semibold text-ink-900 dark:text-white">
            Development infrastructure included
          </h3>
          <p class="mt-2 text-sm leading-6 text-ink-500 dark:text-ink-300">
            Micronaut Test Resources provides the services your application
            depends on during development and testing — no compose files, no
            custom fixtures.
          </p>
          <div class="mt-4 grid grid-cols-2 gap-3">
            {
              testResourceServices.map((service) => (
                <div class="grid min-h-12 place-items-center rounded-md bg-ink-50 p-2.5 text-center text-[0.78rem] font-medium text-ink-600 transition hover:bg-flame-50 dark:bg-ink-800/70 dark:text-ink-300 dark:hover:bg-ink-800">
                  {service}
                </div>
              ))
            }
          </div>
          <div class="mt-4 grid gap-2 text-sm leading-6 text-ink-500 dark:text-ink-300">
            {
              DEEP_DIVES[1]!.bullets.slice(0, 2).map((bullet) => (
                <div class="flex items-center gap-2">
                  <Glyph name="check-circle" class="size-4 text-flame-700 dark:text-flame-400" />
                  <span>{bullet}</span>
                </div>
              ))
            }
          </div>
          <a
            href="/docs/test-resources/"
            class="mt-auto inline-flex items-center gap-1.5 pt-5 text-sm font-semibold text-flame-600 hover:underline dark:text-flame-400"
          >
            Explore Test Resources
            <Glyph name="arrow-right" class="size-4" />
          </a>
        </div>
      </div>
    </section>

    <!-- Stack comparison -->
    <section class="border-b border-ink-200 bg-ink-50/70 dark:border-ink-700 dark:bg-ink-900/50">
      <div class="mx-auto max-w-6xl px-5 py-16">
        <div class="max-w-2xl">
          <h2 class="text-3xl font-bold tracking-tight text-ink-900 dark:text-white md:text-4xl">
            Stop assembling your Python backend
          </h2>
          <p class="mt-4 text-base leading-7 text-ink-500 dark:text-ink-300">
            Python&rsquo;s flexibility is a strength, and every component in a
            hand-assembled stack may be excellent. The cost is the repeated
            integration work between them — and someone has to own it.
          </p>
        </div>
        <BestFitSignals />
        <div class="mt-10 grid max-w-4xl gap-4 md:grid-cols-2">
          <div class="rounded-xl border border-ink-200 bg-white p-6 dark:border-ink-700 dark:bg-ink-900">
            <h3 class="text-base font-semibold text-ink-500 dark:text-ink-300">
              {STACK_COMPARISON.conventional.title}
            </h3>
            <ul class="mt-4 grid gap-2.5">
              {
                STACK_COMPARISON.conventional.items.map((item) => (
                  <li class="flex items-center gap-2.5 text-sm text-ink-500 dark:text-ink-300">
                    <span class="size-1.5 shrink-0 rounded-full bg-ink-300 dark:bg-ink-500" />
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="rounded-xl border border-flame-500/40 bg-white p-6 shadow-md shadow-flame-500/5 dark:border-flame-500/40 dark:bg-ink-900">
            <h3 class="flex items-center gap-2 text-base font-semibold text-flame-700 dark:text-flame-400">
              <Glyph name="flame" class="size-4.5" />
              {STACK_COMPARISON.pyronaut.title}
            </h3>
            <ul class="mt-4 grid gap-2.5">
              {
                STACK_COMPARISON.pyronaut.items.map((item) => (
                  <li class="flex items-center gap-2.5 text-sm text-ink-800 dark:text-ink-100">
                    <Glyph name="check" class="size-4 shrink-0 text-flame-700 dark:text-flame-400" />
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
        <SkepticTest />
      </div>
    </section>

    <!-- Personas -->
    <section id="teams" class="border-b border-ink-200 bg-white dark:border-ink-700 dark:bg-ink-950">
      <div class="mx-auto max-w-6xl px-5 py-16">
        <h2 class="text-3xl font-bold tracking-tight text-ink-900 dark:text-white md:text-4xl">
          Built for teams that ship many services
        </h2>
        <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          {
            PERSONAS.map((persona) => (
              <div class="rounded-xl border border-ink-200 bg-white p-5 dark:border-ink-700 dark:bg-ink-900">
                <p class="text-xs font-bold uppercase tracking-wide text-flame-700 dark:text-flame-400">
                  {persona.role}
                </p>
                <p class="mt-2.5 text-sm leading-6 text-ink-600 dark:text-ink-200">
                  {persona.value}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="border-b border-ink-200 bg-ink-50/70 dark:border-ink-700 dark:bg-ink-900/50">
      <div
        class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-5 py-14 md:flex-row md:items-center md:justify-between"
      >
        <div class="flex items-center gap-7">
          <img
            src="/pyronaut-assets/logo-full.png"
            alt="Pyronaut logo"
            class="hidden w-36 shrink-0 md:block dark:[filter:drop-shadow(0_0_1px_#fff)_drop-shadow(0_0_1px_rgba(255,255,255,0.8))]"
          />
          <div>
            <h2 class="text-2xl font-bold tracking-tight text-ink-900 dark:text-white md:text-3xl">
              Start your first Pyronaut service
            </h2>
            <p class="mt-2 max-w-lg text-base leading-7 text-ink-500 dark:text-ink-300">
              From Python source to a tested, validated production artifact —
              with one consistent workflow.
            </p>
          </div>
        </div>
        <div class="flex flex-wrap gap-3">
          <a
            href="/docs/"
            class="rounded-md bg-flame-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-flame-500"
          >
            Read the docs
          </a>
          <a
            href="https://github.com/micronaut-projects"
            class="rounded-md border border-ink-200 bg-white px-5 py-2.5 text-sm font-semibold text-ink-700 transition hover:bg-ink-50 dark:border-ink-700 dark:bg-ink-900 dark:text-ink-100 dark:hover:bg-ink-800"
          >
            Star on GitHub
          </a>
        </div>
      </div>
    </section>

    <MicronautBand />
  </main>

  <!-- Footer (neutral, micronaut-like) -->
  <footer class="bg-white dark:bg-ink-950">
    <div class="mx-auto max-w-6xl px-5 py-12">
      <div class="grid gap-10 md:grid-cols-[minmax(0,1.2fr)_repeat(3,minmax(0,1fr))]">
        <div>
          <img
            src="/pyronaut-assets/logo-header.png"
            alt="Pyronaut"
            class="h-8 w-auto dark:hidden"
          />
          <img
