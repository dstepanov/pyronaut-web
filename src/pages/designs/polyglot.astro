---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CodeTabs from "@/components/CodeTabs.astro";
import DefineOnce from "@/components/DefineOnce.astro";
import DesignSwitcher from "@/components/DesignSwitcher.astro";
import Glyph from "@/components/Glyph.astro";
import MicronautBand from "@/components/MicronautBand.astro";
import SkepticTest from "@/components/SkepticTest.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import {
  CODE_PROOFS,
  DEEP_DIVES,
  FEATURES,
  FOOTER_COLUMNS,
  HERO,
  PERSONAS,
  SITE_NAME,
  STACK_COMPARISON,
  WORKFLOW,
} from "@/lib/site-content";

/**
 * "Polyglot" — Micronaut's structured, bordered sections combined with
 * GraalVM's design energy: a deep-navy gradient-mesh hero, performance
 * stats, a runtime layer diagram, and a blue→violet→flame spectrum accent.
 */

const navLinks = [
  { label: "Why Pyronaut", href: "#features" },
  { label: "Code", href: "#code" },
  { label: "Workflow", href: "#workflow" },
  { label: "Teams", href: "#teams" },
];

const stats = [
  { value: "1 CLI", label: "whole workflow" },
  { value: "8", label: "workflow stages" },
  { value: "4", label: "validated environments" },
  { value: "5", label: "artifact types" },
];

const runtimeLayers = [
  { title: "Python application", note: "dataclasses · type hints · pytest", tone: "python" },
  { title: "Micronaut platform", note: "HTTP · DI · validation · serde · test", tone: "violet" },
  { title: "GraalPy on GraalVM", note: "JIT or Native Image", tone: "flame" },
  { title: "Production artifact", note: "wheel · container · native · Crema", tone: "solid" },
];

const layerTones: Record<string, string> = {
  python:
    "border-python-blue/40 bg-python-blue/10 text-ink-100 [--dot:var(--color-python-blue)]",
  violet: "border-violet-400/40 bg-violet-500/10 text-ink-100 [--dot:var(--color-violet-400)]",
  flame: "border-flame-500/40 bg-flame-500/10 text-ink-100 [--dot:var(--color-flame-500)]",
  solid:
    "border-transparent bg-gradient-to-r from-python-blue via-violet-500 to-flame-500 text-white [--dot:#fff]",
};
---

<BaseLayout
  title={`${SITE_NAME} — Integrated application platform for Python`}
  bodyClass="bg-white font-sans text-ink-800 antialiased dark:bg-ink-950 dark:text-ink-100"
>
  <!-- Header: dark navy in both modes, GraalVM-style -->
  <header class="sticky top-0 z-40 border-b border-white/10 bg-ink-950/90 text-white backdrop-blur-lg">
    <div
      class="h-0.5 w-full bg-gradient-to-r from-python-blue via-violet-500 to-flame-500"
    >
    </div>
    <div class="mx-auto flex h-16 max-w-7xl items-center gap-8 px-5">
      <a href="/designs/polyglot/" class="flex shrink-0 items-center">
        <img
          src="/pyronaut-assets/logo-header-dark.png"
          alt="Pyronaut"
          class="h-9 w-auto"
        />
      </a>
      <nav class="hidden gap-1 md:flex">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="rounded-md px-3 py-2 text-sm font-medium text-ink-300 transition hover:bg-white/5 hover:text-white"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      <div class="ml-auto flex items-center gap-2">
        <ThemeToggle class="rounded-md p-2 text-ink-300 transition hover:bg-white/10" />
        <a
          href="https://github.com/micronaut-projects"
          class="hidden items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-ink-300 transition hover:bg-white/5 hover:text-white sm:flex"
        >
          <Glyph name="github" class="size-4.5" />
          GitHub
        </a>
        <a
          href="#get-started"
          class="rounded-md bg-gradient-to-r from-flame-500 to-ember-500 px-4 py-2 text-sm font-semibold text-white transition hover:brightness-110"
        >
          Get started
        </a>
      </div>
    </div>
  </header>

  <main>
    <!-- Hero: deep navy with spectrum gradient mesh, both modes -->
    <section class="relative overflow-hidden bg-ink-950 text-white">
      <div
        class="pointer-events-none absolute -left-40 top-[-180px] size-[520px] rounded-full bg-python-blue/25 blur-3xl"
      >
      </div>
      <div
        class="pointer-events-none absolute left-1/3 top-[-120px] size-[460px] rounded-full bg-violet-600/20 blur-3xl"
      >
      </div>
      <div
        class="pointer-events-none absolute -right-32 bottom-[-200px] size-[560px] rounded-full bg-flame-600/25 blur-3xl"
      >
      </div>
      <div
        class="relative mx-auto grid max-w-7xl gap-14 px-5 py-20 lg:grid-cols-[minmax(0,1fr)_430px] lg:items-center lg:py-24"
      >
        <div>
          <p
            class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3.5 py-1.5 text-xs font-semibold text-ink-200"
          >
            <span
              class="size-2 rounded-full bg-gradient-to-r from-python-blue to-flame-500"
            >
            </span>
            {HERO.eyebrow}
          </p>
          <h1
            class="mt-6 max-w-2xl font-display text-5xl font-bold leading-[1.05] tracking-tight md:text-[4rem]"
          >
            Python on top.{" "}
            <span
              class="bg-gradient-to-r from-python-blue via-violet-400 to-flame-400 bg-clip-text text-transparent"
            >
              One platform underneath.
            </span>
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-8 text-ink-300">
            {HERO.copy}
          </p>
          <div class="mt-8 flex flex-wrap gap-3" id="get-started">
            <a
              href="#code"
              class="inline-flex items-center gap-2 rounded-lg bg-gradient-to-r from-flame-500 to-ember-500 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-flame-500/25 transition hover:brightness-110"
            >
              Get started
              <Glyph name="arrow-right" class="size-4" />
            </a>
            <a
              href="#workflow"
              class="inline-flex items-center gap-2 rounded-lg border border-white/20 bg-white/5 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/10"
            >
              See the workflow
            </a>
          </div>
          <!-- GraalVM-style stats row -->
          <dl class="mt-10 grid max-w-xl grid-cols-2 gap-px overflow-hidden rounded-xl border border-white/10 bg-white/10 sm:grid-cols-4">
            {
              stats.map((stat) => (
                <div class="bg-ink-950/90 px-4 py-3.5">
                  <dt class="order-last mt-0.5 text-[0.72rem] font-medium text-ink-400">
                    {stat.label}
                  </dt>
                  <dd class="font-display text-xl font-bold text-white">
                    {stat.value}
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>

        <!-- Runtime layer diagram -->
        <div
          class="rounded-2xl border border-white/10 bg-white/[0.04] p-6 backdrop-blur"
        >
          <p class="text-sm font-semibold text-ink-200">
            One platform, three ecosystems
          </p>
          <p class="mt-1 text-xs leading-5 text-ink-400">
            Python development on GraalPy with the Micronaut application model —
            compiled down to the artifact your workload needs.
          </p>
          <div class="mt-5 grid gap-2.5">
            {
              runtimeLayers.map((layer, index) => (
                <>
                  <div
                    class:list={[
                      "rounded-lg border px-4 py-3",
                      layerTones[layer.tone],
                    ]}
                  >
                    <p class="flex items-center gap-2 text-sm font-semibold">
                      <span class="size-1.5 rounded-full bg-[var(--dot)]" />
                      {layer.title}
                    </p>
                    <p class="mt-0.5 pl-3.5 font-mono text-[0.7rem] text-current opacity-70">
                      {layer.note}
                    </p>
                  </div>
                  {index < runtimeLayers.length - 1 && (
                    <div class="flex justify-center text-ink-500">
                      <Glyph name="arrow-right" class="size-4 rotate-90" />
                    </div>
                  )}
                </>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Features: light micronaut-style body -->
    <section
      id="features"
      class="border-b border-ink-200 bg-ink-50/70 dark:border-ink-700 dark:bg-ink-900/50"
    >
      <div class="mx-auto max-w-7xl px-5 py-18 md:py-20">
        <div
          class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between"
        >
          <h2
            class="max-w-md font-display text-3xl font-bold tracking-tight text-ink-900 dark:text-white md:text-4xl"
          >
            One platform, designed to work together
          </h2>
          <p class="max-w-lg text-base leading-7 text-ink-500 dark:text-ink-300">
            Configuration, testing, validation, infrastructure, and
            packaging - handled one consistent way.
          </p>
        </div>
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {
            FEATURES.map((feature, index) => (
              <a
                href={feature.href}
                class="group relative overflow-hidden rounded-xl border border-ink-200 bg-white p-6 transition hover:-translate-y-0.5 hover:shadow-lg dark:border-ink-700 dark:bg-ink-900"
              >
                <span
                  class:list={[
                    "absolute inset-x-0 top-0 h-0.5",
                    index % 3 === 0
                      ? "bg-python-blue"
                      : index % 3 === 1
                        ? "bg-violet-500"
                        : "bg-flame-500",
                  ]}
                />
                <span class="inline-grid size-11 place-items-center rounded-lg bg-ink-50 text-ink-700 transition group-hover:bg-gradient-to-br group-hover:from-python-blue group-hover:via-violet-500 group-hover:to-flame-500 group-hover:text-white dark:bg-ink-800 dark:text-ink-200">
                  <Glyph name={feature.icon} class="size-5.5" />
                </span>
                <h3 class="mt-4 font-display text-base font-semibold text-ink-900 dark:text-white">
                  {feature.title}
                </h3>
                <p class="mt-2 text-sm leading-6 text-ink-500 dark:text-ink-300">
                  {feature.copy}
                </p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Code showcase -->
    <section
      id="code"
      class="border-b border-ink-200 bg-white dark:border-ink-700 dark:bg-ink-950"
    >
      <div
        class="mx-auto grid max-w-7xl gap-12 px-5 py-18 md:py-20 lg:grid-cols-[360px_minmax(0,1fr)]"
      >
        <div>
          <p
            class="bg-gradient-to-r from-python-blue to-flame-500 bg-clip-text text-sm font-bold uppercase tracking-wider text-transparent"
          >
            The programming model
          </p>
          <h2
            class="mt-3 font-display text-3xl font-bold tracking-tight text-ink-900 dark:text-white md:text-4xl"
          >
            Python that uses Micronaut directly
          </h2>
          <p class="mt-4 text-base leading-7 text-ink-500 dark:text-ink-300">
            Write a controller, inject services, and test the running
            application — with dataclasses, type hints, and pytest you already
            know.
          </p>
          <ul class="mt-7 grid gap-3">
            {
              CODE_PROOFS.map((proof) => (
                <li class="flex items-start gap-2.5 text-sm leading-6 text-ink-600 dark:text-ink-200">
                  <Glyph
                    name="check-circle"
                    class="mt-0.5 size-5 shrink-0 text-python-blue dark:text-flame-400"
                  />
                  {proof}
                </li>
              ))
            }
          </ul>
          <div class="mt-7">
            <DefineOnce />
          </div>
        </div>
        <CodeTabs variant="polyglot" id="pg-code" />
      </div>
    </section>

    <!-- Workflow: gradient pipeline -->
    <section
      id="workflow"
      class="border-b border-ink-200 bg-ink-50/70 dark:border-ink-700 dark:bg-ink-900/50"
    >
      <div class="mx-auto max-w-7xl px-5 py-18 md:py-20">
        <div class="mx-auto max-w-2xl text-center">
          <h2
            class="font-display text-3xl font-bold tracking-tight text-ink-900 dark:text-white md:text-4xl"
          >
            From <code class="font-mono text-flame-700 dark:text-flame-400">create</code> to
            production artifact
          </h2>
          <p class="mt-4 text-base leading-7 text-ink-500 dark:text-ink-300">
            The same platform coordinates how the application is created,
            developed, tested, validated, and packaged.
          </p>
        </div>
        <ol class="relative mt-14 grid gap-8 md:grid-cols-5 md:gap-4">
          <span
            class="absolute left-[10%] right-[10%] top-7 hidden h-0.5 bg-gradient-to-r from-python-blue via-violet-500 to-flame-500 md:block"
          >
          </span>
          {
            WORKFLOW.map((stage, index) => (
              <li class="relative text-center">
                <span class="relative z-10 mx-auto grid size-14 place-items-center rounded-full border-2 border-ink-200 bg-white font-display text-lg font-bold text-ink-900 shadow-sm dark:border-ink-600 dark:bg-ink-900 dark:text-white">
                  {index + 1}
                </span>
                <h3 class="mt-4 font-display text-base font-semibold text-ink-900 dark:text-white">
                  {stage.title}
                </h3>
                <code class="mt-1 block font-mono text-xs text-flame-700 dark:text-flame-400">
                  {stage.command}
                </code>
                <p class="mx-auto mt-2 max-w-[220px] text-sm leading-6 text-ink-500 dark:text-ink-300">
                  {stage.copy}
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Deep dives -->
    <section class="border-b border-ink-200 bg-white dark:border-ink-700 dark:bg-ink-950">
      <div class="mx-auto grid max-w-7xl gap-6 px-5 py-18 md:py-20 lg:grid-cols-3">
        {
          DEEP_DIVES.map((dive, index) => (
            <article class="relative flex flex-col overflow-hidden rounded-xl border border-ink-200 bg-white p-7 dark:border-ink-700 dark:bg-ink-900">
              <span
                class:list={[
                  "absolute inset-x-0 top-0 h-1",
                  index === 0
                    ? "bg-python-blue"
                    : index === 1
                      ? "bg-violet-500"
                      : "bg-gradient-to-r from-python-blue via-violet-500 to-flame-500",
                ]}
              />
              <span class="inline-grid size-12 place-items-center rounded-lg bg-ink-50 text-ink-800 dark:bg-ink-800 dark:text-ink-100">
                <Glyph name={dive.icon} class="size-6" />
              </span>
              <h3 class="mt-5 font-display text-xl font-semibold text-ink-900 dark:text-white">
                {dive.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-ink-500 dark:text-ink-300">
                {dive.copy}
              </p>
              <ul class="mt-5 grid gap-2.5">
                {dive.bullets.map((bullet) => (
                  <li class="flex items-center gap-2.5 text-sm text-ink-600 dark:text-ink-200">
                    <Glyph
                      name="check"
                      class="size-4 shrink-0 text-flame-700 dark:text-flame-400"
                    />
                    {bullet}
                  </li>
                ))}
              </ul>
              <a
                href={dive.href}
                class="mt-auto inline-flex items-center gap-1.5 pt-6 text-sm font-semibold text-python-blue transition hover:gap-2.5 dark:text-flame-400"
              >
                {dive.linkLabel}
                <Glyph name="arrow-right" class="size-4" />
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Stack comparison: dark navy band like the hero -->
    <section class="relative overflow-hidden bg-ink-950 text-white">
      <div
        class="pointer-events-none absolute -left-24 top-0 size-[380px] rounded-full bg-python-blue/15 blur-3xl"
      >
      </div>
      <div
        class="pointer-events-none absolute -right-24 bottom-0 size-[380px] rounded-full bg-flame-600/15 blur-3xl"
      >
      </div>
      <div class="relative mx-auto max-w-7xl px-5 py-18 md:py-20">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="font-display text-3xl font-bold tracking-tight md:text-4xl">
            Stop assembling your Python backend
          </h2>
          <p class="mt-4 text-base leading-7 text-ink-300">
            Python&rsquo;s flexibility is a strength, and every component in a
            hand-assembled stack may be excellent. The cost is the repeated
            integration work between them — and someone has to own it.
          </p>
        </div>
        <div class="mx-auto mt-12 grid max-w-4xl gap-6 md:grid-cols-2">
          <div class="rounded-xl border border-white/10 bg-white/[0.04] p-7">
            <h3 class="font-display text-lg font-semibold text-ink-300">
              {STACK_COMPARISON.conventional.title}
            </h3>
            <ul class="mt-5 grid gap-3">
              {
                STACK_COMPARISON.conventional.items.map((item) => (
                  <li class="flex items-center gap-3 text-sm text-ink-300">
                    <span class="size-1.5 shrink-0 rounded-full bg-ink-400" />
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="relative rounded-xl bg-gradient-to-b from-white/10 to-white/[0.03] p-px">
            <span
              class="pointer-events-none absolute inset-0 rounded-xl bg-gradient-to-r from-python-blue/60 via-violet-500/60 to-flame-500/60 [mask:linear-gradient(#fff_0_0)_content-box,linear-gradient(#fff_0_0)] [mask-composite:exclude] p-px"
            >
            </span>
            <div class="relative rounded-[calc(0.75rem-1px)] bg-ink-900/80 p-7">
              <h3 class="flex items-center gap-2 font-display text-lg font-semibold">
                <span
                  class="bg-gradient-to-r from-python-blue via-violet-400 to-flame-400 bg-clip-text text-transparent"
                >
                  {STACK_COMPARISON.pyronaut.title}
                </span>
              </h3>
              <ul class="mt-5 grid gap-3">
                {
                  STACK_COMPARISON.pyronaut.items.map((item) => (
                    <li class="flex items-center gap-3 text-sm text-white">
                      <Glyph name="check" class="size-4 shrink-0 text-flame-400" />
                      {item}
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
        <SkepticTest tone="dark" />
      </div>
    </section>

    <!-- Personas -->
    <section id="teams" class="border-b border-ink-200 bg-white dark:border-ink-700 dark:bg-ink-950">
      <div class="mx-auto max-w-7xl px-5 py-18 md:py-20">
        <h2
          class="text-center font-display text-3xl font-bold tracking-tight text-ink-900 dark:text-white md:text-4xl"
        >
          Built for teams that ship many services
        </h2>
        <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          {
            PERSONAS.map((persona, index) => (
              <div class="relative overflow-hidden rounded-xl border border-ink-200 bg-ink-50/70 p-6 dark:border-ink-700 dark:bg-ink-900">
                <span
                  class:list={[
                    "absolute inset-y-0 left-0 w-0.5",
                    index % 3 === 0
                      ? "bg-python-blue"
                      : index % 3 === 1
                        ? "bg-violet-500"
                        : "bg-flame-500",
                  ]}
                />
                <p class="font-display text-sm font-bold uppercase tracking-wide text-ink-900 dark:text-white">
                  {persona.role}
                </p>
                <p class="mt-3 text-sm leading-7 text-ink-600 dark:text-ink-200">
                  {persona.value}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="relative overflow-hidden bg-ink-950">
      <div
        class="pointer-events-none absolute inset-x-0 top-0 h-0.5 bg-gradient-to-r from-python-blue via-violet-500 to-flame-500"
      >
      </div>
      <div
        class="pointer-events-none absolute left-1/2 top-1/2 size-[480px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-violet-600/15 blur-3xl"
      >
      </div>
      <div class="relative mx-auto max-w-7xl px-5 py-20 text-center">
        <img
          src="/pyronaut-assets/logo-full.png"
          alt="Pyronaut logo"
          class="mx-auto mb-8 w-52 [filter:drop-shadow(0_0_1px_#fff)_drop-shadow(0_0_1px_rgba(255,255,255,0.8))_drop-shadow(0_0_18px_rgba(139,92,246,0.35))]"
        />
        <h2
          class="mx-auto max-w-2xl font-display text-4xl font-bold tracking-tight text-white"
        >
          Build Python that{" "}
          <span
            class="bg-gradient-to-r from-python-blue via-violet-400 to-flame-400 bg-clip-text text-transparent"
          >
            ships anywhere
          </span>
        </h2>
        <p class="mx-auto mt-4 max-w-md text-base leading-7 text-ink-300">
          Create your first Pyronaut service and go from Python source to a
          tested, validated production artifact.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a
            href="/docs/"
            class="rounded-lg bg-gradient-to-r from-flame-500 to-ember-500 px-7 py-3 text-sm font-semibold text-white shadow-lg shadow-flame-500/25 transition hover:brightness-110"
          >
            Read the docs
          </a>
          <a
            href="https://github.com/micronaut-projects"
            class="rounded-lg border border-white/20 bg-white/5 px-7 py-3 text-sm font-semibold text-white transition hover:bg-white/10"
          >
            Star on GitHub
          </a>
        </div>
      </div>
    </section>

    <MicronautBand tone="dark" />
  </main>

  <!-- Footer -->
  <footer class="border-t border-white/10 bg-ink-950 text-ink-300">
    <div class="mx-auto max-w-7xl px-5 py-14">
      <div
        class="grid gap-10 md:grid-cols-[minmax(0,1.2fr)_repeat(3,minmax(0,1fr))]"
      >
        <div>
          <img
            src="/pyronaut-assets/logo-header-dark.png"
            alt="Pyronaut"
            class="h-9 w-auto"
          />
          <p class="mt-4 max-w-xs text-sm leading-6 text-ink-400">
            An integrated application platform for Python, built on
            Micronaut.
          </p>
        </div>
        {
          FOOTER_COLUMNS.map((column) => (
            <div>
              <h3 class="text-sm font-semibold text-white">{column.title}</h3>
              <ul class="mt-4 grid gap-2.5">
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="text-sm text-ink-400 transition hover:text-flame-400"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <p class="mt-12 border-t border-white/10 pt-6 text-xs text-ink-500">
        © 2026 The Pyronaut Project. Python on GraalPy, powered by the
        Micronaut framework and GraalVM.
      </p>
    </div>
  </footer>

  <DesignSwitcher current="polyglot" />
</BaseLayout>
