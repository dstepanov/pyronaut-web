---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BestFitSignals from "@/components/BestFitSignals.astro";
import CodeTabs from "@/components/CodeTabs.astro";
import DefineOnce from "@/components/DefineOnce.astro";
import DesignSwitcher from "@/components/DesignSwitcher.astro";
import Glyph from "@/components/Glyph.astro";
import MicronautBand from "@/components/MicronautBand.astro";
import SkepticTest from "@/components/SkepticTest.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import {
  CODE_PROOFS,
  DEEP_DIVES,
  FEATURES,
  FOOTER_COLUMNS,
  HERO,
  PERSONAS,
  SITE_NAME,
  STACK_COMPARISON,
  WORKFLOW,
} from "@/lib/site-content";

/**
 * "Mono" — inspired by Micronaut's black Sally mark: ink-drawing
 * monochrome, Swiss typographic discipline, hairline rules, numbered
 * sections. The flamethrower's fire is the single full-color accent;
 * Python blue/yellow appear only as small marks.
 */

const navLinks = [
  { label: "Why Pyronaut", href: "#features" },
  { label: "Code", href: "#code" },
  { label: "Workflow", href: "#workflow" },
  { label: "Teams", href: "#teams" },
];

const sectionHead =
  "flex items-baseline gap-4 border-b border-ink-950/20 pb-5 dark:border-white/15";
const sectionIndex =
  "font-mono text-sm font-bold text-ink-400 dark:text-ink-500";
const sectionTitle =
  "font-display text-3xl font-bold tracking-tight text-ink-950 dark:text-white md:text-4xl";
---

<BaseLayout
  title={`${SITE_NAME} — Integrated application platform for Python`}
  bodyClass="bg-white font-sans text-ink-900 antialiased dark:bg-ink-950 dark:text-ink-100"
>
  <!-- Header -->
  <header
    class="sticky top-0 z-40 border-b border-ink-950/20 bg-white/90 backdrop-blur dark:border-white/15 dark:bg-ink-950/90"
  >
    <div class="mx-auto flex h-16 max-w-6xl items-center gap-8 px-5">
      <a href="/designs/mono/" class="flex shrink-0 items-center">
        <img
          src="/pyronaut-assets/logo-header.png"
          alt="Pyronaut"
          class="h-9 w-auto dark:hidden"
        />
        <img
          src="/pyronaut-assets/logo-header-dark.png"
          alt="Pyronaut"
          class="hidden h-9 w-auto dark:block"
        />
      </a>
      <nav class="hidden gap-6 md:flex">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="font-mono text-xs font-semibold uppercase tracking-wider text-ink-500 transition hover:text-ink-950 dark:text-ink-400 dark:hover:text-white"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      <div class="ml-auto flex items-center gap-2.5">
        <ThemeToggle class="rounded-md p-2 text-ink-600 transition hover:bg-ink-50 dark:text-ink-300 dark:hover:bg-white/10" />
        <a
          href="https://github.com/micronaut-projects"
          class="hidden items-center gap-2 font-mono text-xs font-semibold uppercase tracking-wider text-ink-500 transition hover:text-ink-950 dark:text-ink-400 dark:hover:text-white sm:flex"
        >
          <Glyph name="github" class="size-4.5" />
          GitHub
        </a>
        <a
          href="#get-started"
          class="rounded-md bg-ink-950 px-4 py-2 text-sm font-semibold text-white transition hover:bg-ink-700 dark:bg-white dark:text-ink-950 dark:hover:bg-ink-100"
        >
          Get started
        </a>
      </div>
    </div>
  </header>

  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden">
      <div
        class="relative mx-auto grid max-w-6xl gap-12 px-5 pb-20 pt-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-center lg:pt-20"
      >
        <div>
          <p
            class="flex items-center gap-3 font-mono text-xs font-bold uppercase tracking-[0.25em] text-ink-950 dark:text-white"
          >
            <span class="size-2 bg-ink-950 dark:bg-white"></span>
            {HERO.eyebrow}
          </p>
          <h1
            class="mt-7 font-display text-[4rem] font-bold leading-[0.95] tracking-tight text-ink-950 dark:text-white md:text-[5.5rem]"
          >
            Python on<br />Micronaut<span class="text-flame-600">.</span>
          </h1>
          <p class="mt-7 max-w-lg text-lg leading-8 text-ink-500 dark:text-ink-300">
            {HERO.copy}
          </p>
          <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
            {
              HERO.badges.map((badge, index) => (
                <span class="flex items-center gap-2 font-mono text-xs text-ink-600 dark:text-ink-300">
                  <span
                    class:list={[
                      "size-1.5 rounded-full",
                      index === 0
                        ? "bg-python-blue"
                        : index === 1
                          ? "bg-ink-950 dark:bg-white"
                          : "bg-python-yellow",
                    ]}
                  />
                  {badge}
                </span>
              ))
            }
          </div>
          <div class="mt-9 flex flex-wrap gap-3" id="get-started">
            <a
              href="#code"
              class="inline-flex items-center gap-2 rounded-md bg-ink-950 px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-ink-700 dark:bg-white dark:text-ink-950 dark:hover:bg-ink-100"
            >
              Get started
              <Glyph name="arrow-right" class="size-4" />
            </a>
            <a
              href="#workflow"
              class="inline-flex items-center rounded-md border border-ink-950/30 px-6 py-3.5 text-sm font-semibold text-ink-950 transition hover:bg-ink-50 dark:border-white/25 dark:text-white dark:hover:bg-white/10"
            >
              See the workflow
            </a>
          </div>
        </div>

        <!-- Monochrome mascot, full-color flame -->
        <div class="relative mx-auto w-full max-w-[560px]">
          <img
            src="/pyronaut-assets/mascot-mono.png"
            alt="Pyronaut mascot in monochrome — only the flame keeps its color"
            class="w-full dark:[filter:drop-shadow(0_0_2px_rgba(255,255,255,0.55))_drop-shadow(0_0_24px_rgba(249,115,22,0.2))]"
          />
          <p
            class="mt-4 border-t border-ink-950/20 pt-3 text-right font-mono text-[0.68rem] uppercase tracking-[0.2em] text-ink-400 dark:border-white/15 dark:text-ink-500"
          >
            Fig. 01 — the application, carrying its platform
          </p>
        </div>
      </div>
      <!-- the single color accent rule -->
      <div class="h-1 w-full bg-gradient-to-r from-python-blue via-flame-500 to-python-yellow"></div>
    </section>

    <!-- Features -->
    <section id="features" class="border-b border-ink-950/20 dark:border-white/15">
      <div class="mx-auto max-w-6xl px-5 py-18 md:py-20">
        <div class={sectionHead}>
          <span class={sectionIndex}>01</span>
          <h2 class={sectionTitle}>One platform, designed to work together</h2>
          <p class="ml-auto hidden max-w-xs text-sm leading-6 text-ink-500 dark:text-ink-300 lg:block">
            Configuration, testing, validation, infrastructure, and packaging —
            handled one consistent way.
          </p>
        </div>
        <div
          class="grid gap-px border-x border-b border-ink-950/15 bg-ink-950/15 dark:border-white/10 dark:bg-white/10 sm:grid-cols-2 lg:grid-cols-4"
        >
          {
            FEATURES.map((feature, index) => (
              <a
                href={feature.href}
                class="group bg-white p-6 transition hover:bg-ink-50 dark:bg-ink-950 dark:hover:bg-ink-900"
              >
                <div class="flex items-center justify-between">
                  <span class="text-ink-950 dark:text-white">
                    <Glyph name={feature.icon} class="size-6" />
                  </span>
                  <span class="font-mono text-xs text-ink-400 dark:text-ink-500">
                    0{index + 1}
                  </span>
                </div>
                <h3 class="mt-4 font-display text-base font-semibold text-ink-950 dark:text-white">
                  {feature.title}
                </h3>
                <p class="mt-2 text-sm leading-6 text-ink-500 dark:text-ink-300">
                  {feature.copy}
                </p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Code showcase -->
    <section id="code" class="border-b border-ink-950/20 dark:border-white/15">
      <div class="mx-auto max-w-6xl px-5 py-18 md:py-20">
        <div class={sectionHead}>
          <span class={sectionIndex}>02</span>
          <h2 class={sectionTitle}>Python that uses Micronaut directly</h2>
        </div>
        <div class="mt-10 grid gap-12 lg:grid-cols-[360px_minmax(0,1fr)]">
          <div>
            <p class="text-base leading-7 text-ink-500 dark:text-ink-300">
              Write a controller, inject services, and test the running
              application — with dataclasses, type hints, and pytest you
              already know.
            </p>
            <ul class="mt-7 grid gap-3">
              {
                CODE_PROOFS.map((proof) => (
                  <li class="flex items-start gap-3 border-l-2 border-ink-950 pl-3 text-sm leading-6 text-ink-700 dark:border-white dark:text-ink-200">
                    {proof}
                  </li>
                ))
              }
            </ul>
            <div class="mt-7">
              <DefineOnce />
            </div>
          </div>
          <CodeTabs variant="mono" id="mn-code" />
        </div>
      </div>
    </section>

    <!-- Workflow -->
    <section id="workflow" class="border-b border-ink-950/20 dark:border-white/15">
      <div class="mx-auto max-w-6xl px-5 py-18 md:py-20">
        <div class={sectionHead}>
          <span class={sectionIndex}>03</span>
          <h2 class={sectionTitle}>
            From <code class="font-mono">create</code> to production artifact
          </h2>
        </div>
        <ol
          class="grid gap-px border-x border-b border-ink-950/15 bg-ink-950/15 dark:border-white/10 dark:bg-white/10 md:grid-cols-5"
        >
          {
            WORKFLOW.map((stage, index) => (
              <li class="bg-white p-6 dark:bg-ink-950">
                <span class="font-display text-4xl font-bold text-ink-200 dark:text-ink-700">
                  {index + 1}
                </span>
                <h3 class="mt-3 font-display text-base font-semibold text-ink-950 dark:text-white">
                  {stage.title}
                </h3>
                <code class="mt-1 block font-mono text-xs text-ink-500 dark:text-ink-400">
                  {stage.command}
                </code>
                <p class="mt-2.5 text-sm leading-6 text-ink-500 dark:text-ink-300">
                  {stage.copy}
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Deep dives -->
    <section class="border-b border-ink-950/20 dark:border-white/15">
      <div class="mx-auto max-w-6xl px-5 py-18 md:py-20">
        <div class={sectionHead}>
          <span class={sectionIndex}>04</span>
          <h2 class={sectionTitle}>Where the integration boundary sits</h2>
        </div>
        <div class="mt-10 grid gap-10 lg:grid-cols-3">
          {
            DEEP_DIVES.map((dive, index) => (
              <article class="flex flex-col">
                <div class="flex items-center justify-between border-b border-ink-950/20 pb-4 dark:border-white/15">
                  <span class="text-ink-950 dark:text-white">
                    <Glyph name={dive.icon} class="size-6" />
                  </span>
                  <span class="font-mono text-xs text-ink-400 dark:text-ink-500">
                    04.{index + 1}
                  </span>
                </div>
                <h3 class="mt-5 font-display text-xl font-semibold text-ink-950 dark:text-white">
                  {dive.title}
                </h3>
                <p class="mt-3 text-sm leading-7 text-ink-500 dark:text-ink-300">
                  {dive.copy}
                </p>
                <ul class="mt-5 grid gap-2">
                  {dive.bullets.map((bullet) => (
                    <li class="flex items-center gap-2.5 text-sm text-ink-700 dark:text-ink-200">
                      <span class="size-1 bg-ink-950 dark:bg-white" />
                      {bullet}
                    </li>
                  ))}
                </ul>
                <a
                  href={dive.href}
                  class="mt-auto inline-flex items-center gap-2 pt-6 font-mono text-xs font-bold uppercase tracking-wider text-ink-950 underline decoration-flame-500 decoration-2 underline-offset-4 transition hover:text-flame-700 dark:text-white dark:hover:text-flame-400"
                >
                  {dive.linkLabel}
                  <Glyph name="arrow-right" class="size-3.5" />
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Stack comparison: the one black band -->
    <section class="bg-ink-950 text-white dark:border-y dark:border-white/15">
      <div class="mx-auto max-w-6xl px-5 py-18 md:py-20">
        <div class="flex items-baseline gap-4 border-b border-white/20 pb-5">
          <span class="font-mono text-sm font-bold text-ink-500">05</span>
          <h2 class="font-display text-3xl font-bold tracking-tight md:text-4xl">
            Stop assembling your Python backend
          </h2>
        </div>
        <p class="mt-6 max-w-xl text-base leading-7 text-ink-300">
          Python&rsquo;s flexibility is a strength, and every component in a
          hand-assembled stack may be excellent. The cost is the repeated
          integration work between them — and someone has to own it.
        </p>
        <BestFitSignals tone="dark" />
        <div class="mx-auto mt-12 grid max-w-4xl gap-px overflow-hidden rounded-lg border border-white/20 bg-white/20 md:grid-cols-2">
          <div class="bg-ink-950 p-7">
            <h3 class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-ink-400">
              {STACK_COMPARISON.conventional.title}
            </h3>
            <ul class="mt-5 grid gap-3">
              {
                STACK_COMPARISON.conventional.items.map((item) => (
                  <li class="flex items-center gap-3 text-sm text-ink-300">
                    <span class="size-1 shrink-0 bg-ink-500" />
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="bg-white p-7 text-ink-950">
            <h3 class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-flame-700">
              {STACK_COMPARISON.pyronaut.title}
            </h3>
            <ul class="mt-5 grid gap-3">
              {
                STACK_COMPARISON.pyronaut.items.map((item) => (
                  <li class="flex items-center gap-3 text-sm font-medium">
                    <Glyph name="check" class="size-4 shrink-0 text-flame-600" />
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
        <SkepticTest tone="dark" />
      </div>
    </section>

    <!-- Personas -->
    <section id="teams" class="border-b border-ink-950/20 dark:border-white/15">
      <div class="mx-auto max-w-6xl px-5 py-18 md:py-20">
        <div class={sectionHead}>
          <span class={sectionIndex}>06</span>
          <h2 class={sectionTitle}>Built for teams that ship many services</h2>
        </div>
        <div
          class="grid gap-px border-x border-b border-ink-950/15 bg-ink-950/15 dark:border-white/10 dark:bg-white/10 md:grid-cols-2 lg:grid-cols-4"
        >
          {
            PERSONAS.map((persona) => (
              <div class="bg-white p-6 dark:bg-ink-950">
                <p class="font-mono text-xs font-bold uppercase tracking-wider text-ink-950 dark:text-white">
                  {persona.role}
                </p>
                <p class="mt-3 text-sm leading-7 text-ink-500 dark:text-ink-300">
                  {persona.value}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="relative overflow-hidden">
      <div
        class="mx-auto flex max-w-6xl flex-col items-center gap-10 px-5 py-18 md:flex-row md:justify-between md:py-20"
      >
        <div>
          <h2
            class="max-w-xl font-display text-4xl font-bold tracking-tight text-ink-950 dark:text-white md:text-5xl"
          >
            Light the engines<span class="text-flame-600">.</span>
          </h2>
          <p class="mt-4 max-w-md text-base leading-7 text-ink-500 dark:text-ink-300">
            Create your first Pyronaut service and go from Python source to a
            tested, validated production artifact.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a
              href="/docs/"
              class="rounded-md bg-ink-950 px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-ink-700 dark:bg-white dark:text-ink-950 dark:hover:bg-ink-100"
            >
              Read the docs
            </a>
            <a
              href="https://github.com/micronaut-projects"
              class="rounded-md border border-ink-950/30 px-6 py-3.5 text-sm font-semibold text-ink-950 transition hover:bg-ink-50 dark:border-white/25 dark:text-white dark:hover:bg-white/10"
            >
              Star on GitHub
            </a>
          </div>
        </div>
        <img
          src="/pyronaut-assets/mascot-mono.png"
          alt=""
          aria-hidden="true"
          class="w-72 dark:[filter:drop-shadow(0_0_2px_rgba(255,255,255,0.55))]"
        />
      </div>
      <div class="h-1 w-full bg-gradient-to-r from-python-yellow via-flame-500 to-python-blue"></div>
    </section>

    <MicronautBand />
  </main>

  <!-- Footer -->
  <footer class="bg-white dark:bg-ink-950">
    <div class="mx-auto max-w-6xl px-5 py-12">
      <div class="grid gap-10 md:grid-cols-[minmax(0,1.2fr)_repeat(3,minmax(0,1fr))]">
        <div>
          <img
            src="/pyronaut-assets/logo-header.png"
            alt="Pyronaut"
            class="h-8 w-auto dark:hidden"
          />
          <img
            src="/pyronaut-assets/logo-header-dark.png"
            alt="Pyronaut"
            class="hidden h-8 w-auto dark:block"
          />
          <p class="mt-4 max-w-xs text-sm leading-6 text-ink-500 dark:text-ink-400">
            An integrated application platform for Python, built on
            Micronaut.
          </p>
        </div>
        {
          FOOTER_COLUMNS.map((column) => (
            <div>
              <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-ink-950 dark:text-white">
                {column.title}
              </h3>
              <ul class="mt-4 grid gap-2.5">
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="text-sm text-ink-500 transition hover:text-ink-950 dark:text-ink-400 dark:hover:text-white"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <p class="mt-10 border-t border-ink-950/20 pt-6 text-xs text-ink-400 dark:border-white/15 dark:text-ink-500">
        © 2026 The Pyronaut Project. Python on GraalPy, powered by the
        Micronaut framework and GraalVM.
      </p>
    </div>
  </footer>

  <DesignSwitcher current="mono" />
</BaseLayout>
