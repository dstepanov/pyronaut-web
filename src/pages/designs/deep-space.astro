---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BestFitSignals from "@/components/BestFitSignals.astro";
import CodeTabs from "@/components/CodeTabs.astro";
import DefineOnce from "@/components/DefineOnce.astro";
import DesignSwitcher from "@/components/DesignSwitcher.astro";
import Glyph from "@/components/Glyph.astro";
import MicronautBand from "@/components/MicronautBand.astro";
import SkepticTest from "@/components/SkepticTest.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import {
  CODE_PROOFS,
  DEEP_DIVES,
  FEATURES,
  FOOTER_COLUMNS,
  HERO,
  PERSONAS,
  SITE_NAME,
  STACK_COMPARISON,
  WORKFLOW,
} from "@/lib/site-content";

const navLinks = [
  { label: "Why Pyronaut", href: "#features" },
  { label: "Code", href: "#code" },
  { label: "Workflow", href: "#workflow" },
  { label: "Teams", href: "#teams" },
];
---

<BaseLayout
  title={`${SITE_NAME} — Integrated application platform for Python`}
  bodyClass="bg-ink-50 font-sans text-ink-800 antialiased dark:bg-ink-950 dark:text-ink-100"
>
  <!-- Header -->
  <header
    class="sticky top-0 z-40 border-b border-ink-200/70 bg-ink-50/85 backdrop-blur-lg dark:border-white/10 dark:bg-ink-950/80"
  >
    <div class="mx-auto flex h-16 max-w-7xl items-center gap-8 px-5">
      <a href="/designs/deep-space/" class="flex shrink-0 items-center">
        <img
          src="/pyronaut-assets/logo-header.png"
          alt="Pyronaut"
          class="h-9 w-auto dark:hidden"
        />
        <img
          src="/pyronaut-assets/logo-header-dark.png"
          alt="Pyronaut"
          class="hidden h-9 w-auto dark:block"
        />
      </a>
      <nav class="hidden gap-1 md:flex">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="rounded-lg px-3 py-2 text-sm font-medium text-ink-500 transition hover:bg-white hover:text-ink-800 dark:text-ink-300 dark:hover:bg-white/5 dark:hover:text-white"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      <div class="ml-auto flex items-center gap-2">
        <ThemeToggle class="rounded-lg p-2 text-ink-500 transition hover:bg-white dark:text-ink-300 dark:hover:bg-white/10" />
        <a
          href="https://github.com/micronaut-projects"
          class="hidden items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium text-ink-500 transition hover:bg-white hover:text-ink-800 dark:text-ink-300 dark:hover:bg-white/5 dark:hover:text-white sm:flex"
        >
          <Glyph name="github" class="size-4.5" />
          GitHub
        </a>
        <a
          href="#get-started"
          class="rounded-lg bg-gradient-to-r from-flame-500 to-ember-500 px-4 py-2 text-sm font-semibold text-white shadow-lg shadow-flame-500/30 transition hover:brightness-110"
        >
          Get started
        </a>
      </div>
    </div>
  </header>

  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden border-b border-ink-200/70 dark:border-white/10">
      <!-- starfield: faint ink specks by day, bright stars at night -->
      <div
        class="pointer-events-none absolute inset-0 opacity-25 [--star-color:var(--color-ink-400)] dark:opacity-70 dark:[--star-color:#ffffff]"
        style="background-image: radial-gradient(1px 1px at 12% 28%, var(--star-color) 50%, transparent 51%), radial-gradient(1px 1px at 32% 68%, var(--star-color) 50%, transparent 51%), radial-gradient(1.5px 1.5px at 52% 18%, var(--star-color) 50%, transparent 51%), radial-gradient(1px 1px at 68% 52%, var(--star-color) 50%, transparent 51%), radial-gradient(1.5px 1.5px at 84% 30%, var(--star-color) 50%, transparent 51%), radial-gradient(1px 1px at 22% 88%, var(--star-color) 50%, transparent 51%), radial-gradient(1px 1px at 92% 78%, var(--star-color) 50%, transparent 51%), radial-gradient(1px 1px at 44% 44%, var(--star-color) 50%, transparent 51%);"
        data-starfield
      >
      </div>
      <!-- flame nebula glow -->
      <div
        class="pointer-events-none absolute -bottom-56 left-1/2 h-[560px] w-[900px] -translate-x-1/2 animate-flame-pulse rounded-[50%] bg-gradient-to-t from-flame-500/25 via-ember-500/10 to-transparent blur-3xl dark:from-flame-500/40 dark:via-ember-500/15"
      >
      </div>
      <div
        class="relative mx-auto grid max-w-7xl gap-14 px-5 py-24 lg:grid-cols-[minmax(0,1fr)_480px] lg:items-center"
      >
        <div>
          <p
            class="inline-flex items-center gap-2 rounded-full border border-flame-300 bg-flame-50 px-3.5 py-1.5 text-xs font-semibold text-flame-700 dark:border-flame-500/40 dark:bg-flame-500/10 dark:text-flame-300"
          >
            <Glyph name="flame" class="size-3.5" />
            {HERO.eyebrow}
          </p>
          <h1
            class="mt-6 max-w-2xl font-display text-5xl font-bold leading-[1.05] tracking-tight text-ink-900 dark:text-white md:text-[4.2rem]"
          >
            Build the Python application.{" "}
            <span class="text-flame-gradient">Not the platform around it.</span>
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-8 text-ink-500 dark:text-ink-300">
            {HERO.copy}
          </p>
          <div class="mt-6 flex flex-wrap gap-2">
            {
              HERO.badges.map((badge) => (
                <span class="rounded-full border border-ink-200 bg-white px-3 py-1.5 text-xs font-medium text-ink-500 dark:border-white/15 dark:bg-white/5 dark:text-ink-200">
                  {badge}
                </span>
              ))
            }
          </div>
          <div class="mt-8 flex flex-wrap gap-3" id="get-started">
            <a
              href="#code"
              class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-flame-500 to-ember-500 px-6 py-3.5 text-sm font-semibold text-white shadow-xl shadow-flame-500/30 transition hover:brightness-110"
            >
              Get started
              <Glyph name="arrow-right" class="size-4" />
            </a>
            <a
              href="#workflow"
              class="inline-flex items-center gap-2 rounded-xl border border-ink-200 bg-white px-6 py-3.5 text-sm font-semibold text-ink-700 transition hover:border-flame-400 hover:bg-flame-50 dark:border-white/15 dark:bg-white/5 dark:text-white dark:backdrop-blur dark:hover:border-flame-500/50 dark:hover:bg-flame-500/10"
            >
              See the workflow
            </a>
          </div>
        </div>

        <!-- Mascot on orbit rings — the flame stays whole, overflowing the rings -->
        <div class="relative mx-auto w-full max-w-[480px] animate-drift">
          <div
            class="absolute left-[38%] top-1/2 size-[340px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-gradient-to-br from-flame-500/20 via-ember-500/10 to-python-blue/15 blur-2xl dark:from-flame-500/30 dark:via-ember-500/20 dark:to-python-blue/20"
          >
          </div>
          <div
            class="absolute left-[38%] top-1/2 size-[300px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-ink-300/70 dark:border-white/15"
          >
          </div>
          <div
            class="absolute left-[38%] top-1/2 size-[400px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-ink-200/60 dark:border-white/[0.07]"
          >
            <span
              class="absolute left-[12%] top-[9%] size-2 rounded-full bg-flame-500 shadow-[0_0_10px_2px_rgba(249,115,22,0.55)]"
            >
            </span>
          </div>
          <img
            src="/pyronaut-assets/mascot-wide.png"
            alt="Pyronaut mascot — an astronaut with a Python-powered flamethrower"
            class="relative w-full drop-shadow-[0_16px_32px_rgba(16,21,36,0.18)] dark:drop-shadow-[0_0_28px_rgba(249,115,22,0.25)]"
          />
          <span
            class="absolute -bottom-4 left-[38%] -translate-x-1/2 rounded-full border border-ink-200 bg-white px-4 py-1.5 font-mono text-xs text-flame-700 shadow-md dark:border-white/15 dark:bg-ink-900/90 dark:text-flame-300 dark:backdrop-blur"
          >
            naut@graalpy:~$
          </span>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section
      id="features"
      class="relative border-b border-ink-200/70 bg-white/60 dark:border-white/10 dark:bg-white/[0.02]"
    >
      <div class="mx-auto max-w-7xl px-5 py-20">
        <div
          class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between"
        >
          <h2
            class="max-w-md font-display text-3xl font-bold tracking-tight text-ink-900 dark:text-white md:text-4xl"
          >
            One platform, designed to work together
          </h2>
          <p class="max-w-lg text-base leading-7 text-ink-500 dark:text-ink-300">
            Configuration, testing, validation, infrastructure, and
            packaging - handled one consistent way.
          </p>
        </div>
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {
            FEATURES.map((feature) => (
              <a
                href={feature.href}
                class="group relative rounded-2xl border border-ink-200 bg-white p-6 transition hover:-translate-y-1 hover:border-flame-400 hover:shadow-xl hover:shadow-flame-500/10 dark:border-white/10 dark:bg-white/[0.03] dark:hover:border-flame-500/50 dark:hover:bg-flame-500/[0.06]"
              >
                <span class="inline-grid size-11 place-items-center rounded-xl border border-flame-200 bg-flame-50 text-flame-600 transition group-hover:bg-gradient-to-br group-hover:from-flame-500 group-hover:to-ember-500 group-hover:text-white dark:border-flame-500/30 dark:bg-flame-500/10 dark:text-flame-400">
                  <Glyph name={feature.icon} class="size-5.5" />
                </span>
                <h3 class="mt-4 font-display text-base font-semibold text-ink-900 dark:text-white">
                  {feature.title}
                </h3>
                <p class="mt-2 text-sm leading-6 text-ink-500 dark:text-ink-300">
                  {feature.copy}
                </p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Code showcase -->
    <section id="code" class="relative border-b border-ink-200/70 dark:border-white/10">
      <div
        class="pointer-events-none absolute right-0 top-20 size-[420px] rounded-full bg-python-blue/5 blur-3xl dark:bg-python-blue/10"
      >
      </div>
      <div
        class="relative mx-auto grid max-w-7xl gap-12 px-5 py-20 lg:grid-cols-[360px_minmax(0,1fr)]"
      >
        <div>
          <p
            class="text-sm font-semibold uppercase tracking-wider text-flame-700 dark:text-flame-400"
          >
            The programming model
          </p>
          <h2
            class="mt-3 font-display text-3xl font-bold tracking-tight text-ink-900 dark:text-white md:text-4xl"
          >
            Python that uses Micronaut directly
          </h2>
          <p class="mt-4 text-base leading-7 text-ink-500 dark:text-ink-300">
            Write a controller, inject services, and test the running
            application — with dataclasses, type hints, and pytest you already
            know.
          </p>
          <ul class="mt-7 grid gap-3">
            {
              CODE_PROOFS.map((proof) => (
                <li class="flex items-start gap-2.5 text-sm leading-6 text-ink-600 dark:text-ink-200">
                  <Glyph
                    name="check-circle"
                    class="mt-0.5 size-5 shrink-0 text-flame-500 dark:text-flame-400"
                  />
                  {proof}
                </li>
              ))
            }
          </ul>
          <div class="mt-7">
            <DefineOnce />
          </div>
        </div>
        <CodeTabs variant="deep-space" id="ds-code" />
      </div>
    </section>

    <!-- Workflow -->
    <section
      id="workflow"
      class="border-b border-ink-200/70 bg-white/60 dark:border-white/10 dark:bg-white/[0.02]"
    >
      <div class="mx-auto max-w-7xl px-5 py-20">
        <div class="mx-auto max-w-2xl text-center">
          <p
            class="text-sm font-semibold uppercase tracking-wider text-flame-700 dark:text-flame-400"
          >
            One application workflow
          </p>
          <h2
            class="mt-3 font-display text-3xl font-bold tracking-tight text-ink-900 dark:text-white md:text-4xl"
          >
            From <code class="font-mono text-flame-700 dark:text-flame-400">create</code> to
            production artifact
          </h2>
          <p class="mt-4 text-base leading-7 text-ink-500 dark:text-ink-300">
            The same platform coordinates how the application is created,
            developed, tested, validated, and packaged.
          </p>
        </div>
        <ol class="relative mt-14 grid gap-8 md:grid-cols-5 md:gap-4">
          <span
            class="absolute left-0 right-0 top-8 hidden h-px bg-gradient-to-r from-transparent via-flame-500/50 to-transparent md:block"
          >
          </span>
          {
            WORKFLOW.map((stage, index) => (
              <li class="relative text-center md:text-left">
                <span class="relative z-10 mx-auto inline-grid size-16 place-items-center rounded-2xl border border-flame-400/60 bg-white font-display text-xl font-bold text-flame-600 shadow-lg shadow-flame-500/15 dark:border-flame-500/40 dark:bg-ink-900 dark:text-flame-400 dark:shadow-flame-500/20 md:mx-0">
                  {index + 1}
                </span>
                <h3 class="mt-4 font-display text-base font-semibold text-ink-900 dark:text-white">
                  {stage.title}
                </h3>
                <code class="mt-1 block font-mono text-xs text-flame-700 dark:text-flame-400/90">
                  {stage.command}
                </code>
                <p class="mt-2 text-sm leading-6 text-ink-500 dark:text-ink-300">
                  {stage.copy}
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Deep dives -->
    <section class="border-b border-ink-200/70 dark:border-white/10">
      <div class="mx-auto grid max-w-7xl gap-6 px-5 py-20 lg:grid-cols-3">
        {
          DEEP_DIVES.map((dive) => (
            <article class="flex flex-col rounded-2xl border border-ink-200 bg-white p-7 dark:border-white/10 dark:bg-transparent dark:bg-gradient-to-b dark:from-white/[0.06] dark:to-white/[0.01]">
              <span class="inline-grid size-12 place-items-center rounded-xl bg-gradient-to-br from-flame-500 to-ember-500 text-white shadow-lg shadow-flame-500/30">
                <Glyph name={dive.icon} class="size-6" />
              </span>
              <h3 class="mt-5 font-display text-xl font-semibold text-ink-900 dark:text-white">
                {dive.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-ink-500 dark:text-ink-300">
                {dive.copy}
              </p>
              <ul class="mt-5 grid gap-2.5">
                {dive.bullets.map((bullet) => (
                  <li class="flex items-center gap-2.5 text-sm text-ink-600 dark:text-ink-200">
                    <Glyph
                      name="check"
                      class="size-4 shrink-0 text-flame-500 dark:text-flame-400"
                    />
                    {bullet}
                  </li>
                ))}
              </ul>
              <a
                href={dive.href}
                class="mt-auto inline-flex items-center gap-1.5 pt-6 text-sm font-semibold text-flame-600 transition hover:gap-2.5 dark:text-flame-400"
              >
                {dive.linkLabel}
                <Glyph name="arrow-right" class="size-4" />
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Stack comparison -->
    <section class="border-b border-ink-200/70 bg-white/60 dark:border-white/10 dark:bg-white/[0.02]">
      <div class="mx-auto max-w-7xl px-5 py-20">
        <div class="mx-auto max-w-2xl text-center">
          <h2
            class="font-display text-3xl font-bold tracking-tight text-ink-900 dark:text-white md:text-4xl"
          >
            Stop assembling your Python backend
          </h2>
          <p class="mt-4 text-base leading-7 text-ink-500 dark:text-ink-300">
            Python&rsquo;s flexibility is a strength, and every component in a
            hand-assembled stack may be excellent. The cost is the repeated
            integration work between them — and someone has to own it.
          </p>
        </div>
        <BestFitSignals />
        <div class="mx-auto mt-12 grid max-w-4xl gap-6 md:grid-cols-2">
          <div class="rounded-2xl border border-ink-200 bg-white p-7 dark:border-white/10 dark:bg-white/[0.03]">
            <h3 class="font-display text-lg font-semibold text-ink-500 dark:text-ink-300">
              {STACK_COMPARISON.conventional.title}
            </h3>
            <ul class="mt-5 grid gap-3">
              {
                STACK_COMPARISON.conventional.items.map((item) => (
                  <li class="flex items-center gap-3 text-sm text-ink-500 dark:text-ink-300">
                    <span class="size-1.5 shrink-0 rounded-full bg-ink-400" />
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="relative rounded-2xl border border-flame-500/50 bg-gradient-to-b from-flame-500/10 to-transparent p-7 shadow-xl shadow-flame-500/10 dark:from-flame-500/15 dark:shadow-2xl">
            <span
              class="absolute -top-3 right-6 rounded-full bg-gradient-to-r from-flame-500 to-ember-500 px-3 py-1 text-[0.68rem] font-bold uppercase tracking-wider text-white"
            >
              Pyronaut
            </span>
            <h3
              class="flex items-center gap-2 font-display text-lg font-semibold text-flame-600 dark:text-flame-300"
            >
              <Glyph name="flame" class="size-5" />
              {STACK_COMPARISON.pyronaut.title}
            </h3>
            <ul class="mt-5 grid gap-3">
              {
                STACK_COMPARISON.pyronaut.items.map((item) => (
                  <li class="flex items-center gap-3 text-sm text-ink-800 dark:text-white">
                    <Glyph name="check" class="size-4 shrink-0 text-flame-500 dark:text-flame-400" />
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
        <SkepticTest />
      </div>
    </section>

    <!-- Personas -->
    <section id="teams" class="border-b border-ink-200/70 dark:border-white/10">
      <div class="mx-auto max-w-7xl px-5 py-20">
        <h2
          class="text-center font-display text-3xl font-bold tracking-tight text-ink-900 dark:text-white md:text-4xl"
        >
          Built for teams that ship many services
        </h2>
        <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          {
            PERSONAS.map((persona) => (
              <div class="rounded-2xl border border-ink-200 bg-white p-6 dark:border-white/10 dark:bg-white/[0.03]">
                <p class="font-display text-sm font-bold uppercase tracking-wide text-flame-700 dark:text-flame-400">
                  {persona.role}
                </p>
                <p class="mt-3 text-sm leading-7 text-ink-600 dark:text-ink-200">
                  {persona.value}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA band -->
    <section class="relative overflow-hidden">
      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 h-72 bg-gradient-to-t from-flame-600/20 via-ember-500/5 to-transparent blur-2xl dark:from-flame-600/30 dark:via-ember-500/10"
      >
      </div>
      <div class="relative mx-auto max-w-7xl px-5 py-24 text-center">
        <img
          src="/pyronaut-assets/logo-full.png"
          alt="Pyronaut logo"
          class="mx-auto w-56 drop-shadow-2xl dark:[filter:drop-shadow(0_0_1px_#fff)_drop-shadow(0_0_1px_rgba(255,255,255,0.8))_drop-shadow(0_0_18px_rgba(249,115,22,0.35))]"
        />
        <h2
          class="mx-auto mt-6 max-w-xl font-display text-4xl font-bold tracking-tight text-ink-900 dark:text-white"
        >
          Light the engines
        </h2>
        <p class="mx-auto mt-4 max-w-md text-base leading-7 text-ink-500 dark:text-ink-300">
          Create your first Pyronaut service and go from Python source to a
          tested, validated production artifact.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a
            href="/docs/"
            class="rounded-xl bg-gradient-to-r from-flame-500 to-ember-500 px-7 py-3.5 text-sm font-semibold text-white shadow-xl shadow-flame-500/30 transition hover:brightness-110"
          >
            Read the docs
          </a>
          <a
            href="https://github.com/micronaut-projects"
            class="rounded-xl border border-ink-200 bg-white px-7 py-3.5 text-sm font-semibold text-ink-800 transition hover:bg-ink-50 dark:border-white/15 dark:bg-white/5 dark:text-white dark:hover:bg-white/10"
          >
            Star on GitHub
          </a>
        </div>
      </div>
    </section>

    <MicronautBand />
  </main>

  <!-- Footer -->
  <footer class="border-t border-ink-200/70 bg-ink-950 text-ink-300 dark:border-white/10">
    <div class="mx-auto max-w-7xl px-5 py-14">
      <div
        class="grid gap-10 md:grid-cols-[minmax(0,1.2fr)_repeat(3,minmax(0,1fr))]"
      >
        <div>
          <img
            src="/pyronaut-assets/logo-header-dark.png"
            alt="Pyronaut"
            class="h-9 w-auto"
          />
          <p class="mt-4 max-w-xs text-sm leading-6 text-ink-400">
            An integrated application platform for Python, built on
            Micronaut.
          </p>
        </div>
        {
          FOOTER_COLUMNS.map((column) => (
            <div>
              <h3 class="text-sm font-semibold text-white">{column.title}</h3>
              <ul class="mt-4 grid gap-2.5">
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="text-sm text-ink-400 transition hover:text-flame-400"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <p class="mt-12 border-t border-white/10 pt-6 text-xs text-ink-500">
        © 2026 The Pyronaut Project. Python on GraalPy, powered by the
        Micronaut framework and GraalVM.
      </p>
    </div>
  </footer>

  <DesignSwitcher current="deep-space" />
</BaseLayout>
