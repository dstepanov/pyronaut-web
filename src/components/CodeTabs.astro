---
import { Code } from "astro:components";
import { CODE_EXAMPLES } from "@/lib/site-content";

/**
 * Tabbed code showcase. Renders dual Shiki themes (light + dark);
 * global.css switches token colors when `.dark` is active.
 *
 * Contrast hierarchy (light mode): the title bar and tab strip form one
 * white chrome zone (hairline between them) and the code + caption sit on
 * one tinted inset surface — two clean strata, colored traffic dots for life.
 */
interface Props {
  id?: string;
}

const { id = "code-tabs" } = Astro.props;

const s = {
  frame:
    "overflow-hidden rounded-2xl border border-ink-200 bg-white shadow-[0_24px_48px_-24px_rgba(16,21,36,0.25)] dark:border-white/10 dark:bg-ink-900",
  bar: "flex items-center gap-3 border-b border-ink-100 bg-white px-4 py-3 dark:border-white/10 dark:bg-white/[0.04]",
  file: "font-mono text-xs uppercase tracking-widest text-ink-400 dark:text-ink-300",
  tabs: "flex gap-1 border-b border-ink-100 px-3 pt-2 dark:border-white/10",
  tab: "rounded-t-lg px-4 py-2 font-mono text-xs font-semibold uppercase tracking-wider text-ink-400 transition hover:text-ink-800 dark:hover:text-white",
  tabActive: "!text-ink-950 border-b-2 border-flame-500 dark:!text-white",
  /** Code area surface — tinted in light mode so code reads as an inset object. */
  panel: "bg-ink-50/60 dark:bg-transparent",
  caption:
    "border-t border-ink-200/70 px-4 py-3 text-xs leading-5 text-ink-500 dark:border-white/10 dark:text-ink-300",
};
---

<div class:list={["code-tabs", s.frame]} data-code-tabs={id}>
  <div class={s.bar}>
    <span class="flex gap-1.5">
      <span class="size-2.5 rounded-full bg-ember-500/90"></span>
      <span class="size-2.5 rounded-full bg-python-yellow/90"></span>
      <span class="size-2.5 rounded-full bg-flame-400/90"></span>
    </span>
    {
      CODE_EXAMPLES.map((example, index) => (
        <span
          class:list={[s.file, index > 0 && "hidden"]}
          data-tab-file={example.id}
        >
          {example.filename}
        </span>
      ))
    }
  </div>
  <div class={s.tabs} role="tablist" aria-label="Code examples">
    {
      CODE_EXAMPLES.map((example, index) => (
        <button
          type="button"
          role="tab"
          id={`${id}-tab-${example.id}`}
          aria-controls={`${id}-panel-${example.id}`}
          aria-selected={index === 0 ? "true" : "false"}
          class:list={[s.tab, index === 0 && s.tabActive]}
          data-tab={example.id}
          data-active-class={s.tabActive}
        >
          {example.label}
        </button>
      ))
    }
  </div>
  {
    CODE_EXAMPLES.map((example, index) => (
      <div
        role="tabpanel"
        id={`${id}-panel-${example.id}`}
        aria-labelledby={`${id}-tab-${example.id}`}
        class:list={[s.panel, index > 0 && "hidden"]}
        data-tab-panel={example.id}
      >
        <Code
          code={example.code}
          lang={example.language}
          themes={{ light: "one-light", dark: "one-dark-pro" }}
          defaultColor="light"
        />
        <p class={s.caption}>{example.caption}</p>
      </div>
    ))
  }
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-code-tabs]")) {
    const tabs = root.querySelectorAll<HTMLButtonElement>("[data-tab]");
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const target = tab.dataset.tab;
        const activeClasses = (tab.dataset.activeClass ?? "").split(/\s+/).filter(Boolean);
        tabs.forEach((other) => {
          const active = other === tab;
          other.setAttribute("aria-selected", active ? "true" : "false");
          activeClasses.forEach((cls) => other.classList.toggle(cls, active));
        });
        root
          .querySelectorAll<HTMLElement>("[data-tab-panel]")
          .forEach((panel) => panel.classList.toggle("hidden", panel.dataset.tabPanel !== target));
        root
          .querySelectorAll<HTMLElement>("[data-tab-file]")
          .forEach((file) => file.classList.toggle("hidden", file.dataset.tabFile !== target));
      });
    });
  }
</script>
