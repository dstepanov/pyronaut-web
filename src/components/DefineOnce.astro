---
import { DEFINE_ONCE } from "@/lib/site-content";

interface Props {
  /** adaptive = light with dark: overrides; dark = always-dark section */
  tone?: "adaptive" | "dark";
}

const { tone = "adaptive" } = Astro.props;

const box =
  tone === "dark"
    ? "rounded-2xl border border-white/15 bg-white/[0.04] p-5"
    : "rounded-2xl border border-ink-200 bg-white p-5 dark:border-white/10 dark:bg-white/[0.03]";
const source =
  tone === "dark"
    ? "inline-flex items-center gap-2 rounded-lg bg-gradient-to-r from-flame-500 to-ember-500 px-3 py-1.5 font-mono text-xs font-bold text-white"
    : "inline-flex items-center gap-2 rounded-lg bg-gradient-to-r from-flame-500 to-ember-500 px-3 py-1.5 font-mono text-xs font-bold text-white";
const label =
  tone === "dark"
    ? "text-xs font-semibold uppercase tracking-wider text-ink-300"
    : "text-xs font-semibold uppercase tracking-wider text-ink-400 dark:text-ink-300";
const chip =
  tone === "dark"
    ? "rounded-md border border-white/15 bg-white/5 px-2.5 py-1 text-xs font-medium text-ink-200"
    : "rounded-md border border-ink-200 bg-ink-50 px-2.5 py-1 text-xs font-medium text-ink-600 dark:border-white/10 dark:bg-white/5 dark:text-ink-200";
---

<div class={box}>
  <div class="flex flex-wrap items-center gap-3">
    <span class={source}>{DEFINE_ONCE.source}</span>
    <span class={label}>USED ACROSS</span>
  </div>
  <div class="mt-3.5 flex flex-wrap gap-2">
    {DEFINE_ONCE.targets.map((target) => <span class={chip}>{target}</span>)}
  </div>
</div>
