---
import { BEST_FIT_SIGNALS } from "@/lib/site-content";

interface Props {
  tone?: "adaptive" | "dark";
}

const { tone = "adaptive" } = Astro.props;

const heading =
  tone === "dark"
    ? "text-center text-sm font-semibold uppercase tracking-wider text-ink-400"
    : "text-center text-sm font-semibold uppercase tracking-wider text-ink-400 dark:text-ink-400";
const quote =
  tone === "dark"
    ? "rounded-full border border-white/15 bg-white/[0.04] px-4 py-2 text-sm italic text-ink-300"
    : "rounded-full border border-ink-200 bg-white px-4 py-2 text-sm italic text-ink-500 dark:border-white/10 dark:bg-white/[0.04] dark:text-ink-300";
---

<div class="mx-auto mt-12 max-w-4xl">
  <p class={heading}>Sound familiar?</p>
  <div class="mt-5 flex flex-wrap justify-center gap-2.5">
    {
      BEST_FIT_SIGNALS.map((signal) => (
        <span class={quote}>&ldquo;{signal}&rdquo;</span>
      ))
    }
  </div>
</div>
