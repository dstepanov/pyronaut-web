---
/**
 * Floating switcher so the design candidates can be compared quickly.
 */
interface Props {
  current:
    | "mission-control"
    | "deep-space"
    | "classic"
    | "polyglot"
    | "ignition"
    | "mono";
}

const { current } = Astro.props;

const designs = [
  { id: "mission-control", label: "Mission Control", href: "/designs/mission-control/" },
  { id: "deep-space", label: "Deep Space", href: "/designs/deep-space/" },
  { id: "classic", label: "Classic", href: "/designs/classic/" },
  { id: "polyglot", label: "Polyglot", href: "/designs/polyglot/" },
  { id: "ignition", label: "Ignition", href: "/designs/ignition/" },
  { id: "mono", label: "Mono", href: "/designs/mono/" },
];
---

<div
  class="fixed bottom-4 left-1/2 z-50 flex -translate-x-1/2 items-center gap-1 rounded-full border border-ink-700 bg-ink-900/95 p-1.5 text-xs font-medium text-ink-300 shadow-2xl shadow-black/40 backdrop-blur"
>
  <a
    href="/"
    class="rounded-full px-2.5 py-1.5 transition hover:bg-white/10 hover:text-white"
    title="Back to design chooser"
  >
    ← Designs
  </a>
  <span class="h-4 w-px bg-ink-700"></span>
  {
    designs.map((design) => (
      <a
        href={design.href}
        class:list={[
          "rounded-full px-2.5 py-1.5 transition",
          design.id === current
            ? "bg-gradient-to-r from-flame-500 to-ember-500 text-white shadow"
            : "hover:bg-white/10 hover:text-white",
        ]}
        aria-current={design.id === current ? "page" : undefined}
      >
        {design.label}
      </a>
    ))
  }
</div>
